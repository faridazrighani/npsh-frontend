l so the final value can be replaced/confirmed from datasheet or manufacturer test curve.","Suction nozzle elevation follows PIPE-1 endpoint/pump inlet datum.","Discharge nozzle elevation follows PIPE-2 endpoint/pump outlet datum.","User-defined NPSH margin basis was preserved because both ratio and absolute margin are available."],"references":["ANSI/HI 9.6.1-2024: NPSHA is system-derived; NPSHR is pump/vendor-derived; use margin ratio and absolute margin.","Fluid Mechanics references: system head is boundary head difference plus suction/discharge losses.","Centrifugal pump cavitation literature: verify NPSHr and efficiency with manufacturer/test curve for final validation."],"applied":false,"retainedJournalDutyPoint":true,"academicValidationNote":"Proposal stored for Optimize Pump From Network audit; original journal/literature pump inputs remain retained.","backendGenerated":true,"backendFreshnessBasis":"Fresh /api/simulate calculationId and dependencyFingerprint","modelSignature":null,"sourcePumpInputs":null},"routeTrace":{"schemaVersion":"route-trace.v2","pumpId":"P-100","text":"Fluid Basis -> SRC-100 -> PIPE-1 -> P-100 -> PIPE-2 -> SNK-100","sequence":["FLUID","SRC-100","PIPE-1","P-100","PIPE-2","SNK-100"],"hydraulicStatus":"Safe","engineeringStatus":"Warning","sections":{"suction":{"text":"SRC-100 -> PIPE-1 -> P-100","sequence":["SRC-100","PIPE-1","P-100"],"totalLossM":0.014,"pressureDropBar":0.001325,"directNpshImpact":true,"note":"Suction pipe/fitting/valve/equipment losses subtract directly from NPSHa."},"discharge":{"text":"P-100 -> PIPE-2 -> SNK-100","sequence":["P-100","PIPE-2","SNK-100"],"totalLossM":0.282501,"pressureDropBar":0.026743,"directNpshImpact":false,"note":"Discharge pipe/fitting/valve/equipment losses affect system head and outlet pressure, not direct pump suction NPSHa."}},"dependencyChain":["Fluid Basis -> density, viscosity, vapor pressure","SRC -> suction pressure/elevation boundary head","Pipe/Fitting/Valve (suction) -> suction loss subtracts from NPSHa","Pump -> NPSHa versus NPSHr and margin status","Pipe/Fitting/Valve (discharge) -> system head and outlet pressure","SNK -> downstream boundary closes the route calculation"],"audit":{"sourceOfTruth":"backend","routeOrder":"First Opening -> Fluid Basis -> SRC -> Pipe/Fitting/Valve (suction) -> Pump -> Pipe/Fitting/Valve (discharge) -> SNK","literatureBasis":["Bernoulli/mechanical-energy balance for boundary heads","Darcy-Weisbach and K-method/Cv method for route losses","NPSHa/NPSHr margin screening for centrifugal pump cavitation potential"],"fallbackTraceBoundary":"If a detailed node calculationTrace is unavailable, route trace falls back to solved node result fields and marks missing fields in step.audit.dataStatus.","protectedFormulaSource":"Private backend adapter; public frontend receives audit-safe trace metadata and results, not private solver source."},"steps":[{"order":1,"id":"FLUID","type":"fluid","name":"Fluid Basis","side":"","stage":"Fluid Basis","role":"Thermodynamic and unit calculation basis","directNpshImpact":false,"systemHeadImpact":false,"formulaGroup":"fluid-basis-property-chain","formula":"Fluid basis supplies rho, viscosity, vapor pressure, and unit standard for every downstream hydraulic/NPSH term.","literatureReferences":["cengel-fluid-mechanics-3e"],"assumptions":["single-phase liquid basis","vapor pressure is absolute"],"limitations":["custom fluids remain user/vendor responsibility"],"audit":{"sourceOfTruth":"backend","traceBoundary":"model.FLUID.props with fallback to pump result.calculationTrace.basis","dataStatus":{"status":"available","availableFields":["fluidName","temperatureDegC","densityKgM3","viscosityCSt","vaporPressureBarA"],"missingFields":[]},"dependencyKeys":["FLUID.props","SETTINGS.props.unitStandard"],"staleWhenChanged":["Changing density, viscosity, vapor pressure, fluid name, temperature, or unit standard invalidates the whole route calculation."]},"values":{"fluidName":"Hot Water","temperatureDegC":90,"densityKgM3":965,"viscosityCSt":0.331606,"vaporPressureBarA":0.701317}},{"order":2,"id":"SRC-100","type":"source","name":"TK-2941 Hot Water Tank","side":"","stage":"SRC","role":"Upstream suction boundary","directNpshImpact":false,"systemHeadImpact":false,"formulaGroup":"source-boundary-hydraulic-head","formula":"H_SRC = P_abs/(rho*g) + z_SRC + v^2/(2*g), after pressure basis conversion.","literatureReferences":["cengel-fluid-mechanics-3e","fox-mcdonald-fluid-mechanics-10e"],"assumptions":["steady incompressible boundary","absolute pressure basis before NPSH evaluation"],"limitations":["transient surge and two-phase effects are outside current scope"],"audit":{"sourceOfTruth":"backend","traceBoundary":"nodeResults[source].results.calculationTrace.boundary/inputBasis with fallback to solved node results","dataStatus":{"status":"available","availableFields":["pressureBarA","elevationM","hydraulicHeadM"],"missingFields":[]},"dependencyKeys":["source.props.sourceType","source.props.boundaryDataSource","source.props.pressure","source.props.pressureInputBasis","source.props.pressureEnergyBasis","source.props.elevation","source.props.temperatureMode","source.props.temp","source.props.flowInputMode","source.props.flow","source.props.massFlow"],"staleWhenChanged":["Changing SRC pressure, elevation, temperature mode, custom temperature, flow, or attachment invalidates suction boundary and pump NPSHa."]},"values":{"pressureBarA":2.024009,"elevationM":1.4,"hydraulicHeadM":22.78}},{"order":3,"id":"PIPE-1","type":"pipe","name":"Suction NPS 8 Sch 40","side":"suction","stage":"Pipe/Fitting/Valve (suction)","role":"Suction path loss; subtracts directly from NPSHa","directNpshImpact":true,"systemHeadImpact":false,"formulaGroup":"darcy-weisbach-pipe-loss","formula":"HL_suction = major loss + minor/fitting/valve loss; this loss subtracts directly from NPSHa.","literatureReferences":["cengel-fluid-mechanics-3e","fox-mcdonald-fluid-mechanics-10e"],"assumptions":["steady single-phase route flow","K/Cv/equivalent-length data is screening unless vendor verified"],"limitations":["component-specific vendor curves supersede generic K/Cv assumptions"],"audit":{"sourceOfTruth":"backend","traceBoundary":"nodeResults[routeObject].results.calculationTrace totals/hydraulic with fallback to solved head-loss results","dataStatus":{"status":"available","availableFields":["headLossM","pressureDropBar","majorLossM","minorLossM"],"missingFields":["npshLossContributionM"]},"dependencyKeys":["suctionRoute.props.geometry","suctionRoute.props.roughness","suctionRoute.props.fittingK","suctionRoute.props.valveCvOrK"],"staleWhenChanged":["Changing suction pipe/fitting/valve data invalidates suction loss and NPSHa."]},"values":{"headLossM":0.014,"pressureDropBar":0.001325,"majorLossM":0.00985,"minorLossM":0.00415,"npshLossContributionM":null}},{"order":4,"id":"P-100","type":"pump","name":"P-2941 A","side":"","stage":"Pump","role":"Pump head and NPSH margin evaluation","directNpshImpact":false,"systemHeadImpact":true,"formulaGroup":"pump-npsh-and-performance","formula":"NPSHa = suction energy at pump - vapor pressure head; margin = NPSHa - NPSHr.","literatureReferences":["grist-cavitation-centrifugal-pump-1998","hydraulic-institute-npsh-margin-2024"],"assumptions":["NPSHr follows selected pump curve/manual/engineering-fit basis","pump duty is evaluated at solved route flow"],"limitations":["not a CFD cavitation or transient flashing model"],"audit":{"sourceOfTruth":"backend","traceBoundary":"backend pump npshEvaluation result","dataStatus":{"status":"available","availableFields":["flowM3H","pumpHeadM","npshaM","npshrM","npshMarginM","npshRatio","hydraulicStatus","engineeringStatus"],"missingFields":[]},"dependencyKeys":["pump.props.curveData","pump.props.designFlow","pump.props.designHead","pump.props.designNpshr","pump.props.npshMarginBasis","pump.props.suctionElevation"],"staleWhenChanged":["Changing pump curve, NPSHr, margin criteria, or nozzle elevation invalidates pump status and action readiness."]},"values":{"flowM3H":39.68,"pumpHeadM":37.674,"npshaM":15.3581,"npshrM":1,"npshMarginM":14.3581,"npshRatio":15.3581,"hydraulicStatus":"Safe","engineeringStatus":"Warning"}},{"order":5,"id":"PIPE-2","type":"pipe","name":"Discharge NPS 6 Sch 40","side":"discharge","stage":"Pipe/Fitting/Valve (discharge)","role":"Discharge path loss; affects system head and outlet pressure","directNpshImpact":false,"systemHeadImpact":true,"formulaGroup":"darcy-weisbach-pipe-loss","formula":"HL_discharge = major loss + minor/fitting/valve loss; this affects system head/outlet pressure, not direct NPSHa.","literatureReferences":["cengel-fluid-mechanics-3e","fox-mcdonald-fluid-mechanics-10e"],"assumptions":["steady single-phase route flow","same flow basis as pump duty point"],"limitations":["branched/loop networks require explicit route validation"],"audit":{"sourceOfTruth":"backend","traceBoundary":"nodeResults[routeObject].results.calculationTrace totals/hydraulic with fallback to solved head-loss results","dataStatus":{"status":"available","availableFields":["headLossM","pressureDropBar","majorLossM","minorLossM"],"missingFields":["npshLossContributionM"]},"dependencyKeys":["dischargeRoute.props.geometry","dischargeRoute.props.roughness","dischargeRoute.props.fittingK","dischargeRoute.props.valveCvOrK"],"staleWhenChanged":["Changing discharge pipe/fitting/valve data invalidates system head, outlet pressure, and solved operating point."]},"values":{"headLossM":0.282501,"pressureDropBar":0.026743,"majorLossM":0.282501,"minorLossM":0,"npshLossContributionM":null}},{"order":6,"id":"SNK-100","type":"sink","name":"Reactor Jacket / User D-2201","side":"","stage":"SNK","role":"Downstream discharge boundary","directNpshImpact":false,"systemHeadImpact":true,"formulaGroup":"sink-boundary-hydraulic-head","formula":"H_SNK closes the route through downstream pressure/elevation or flow-demand boundary conditions.","literatureReferences":["cengel-fluid-mechanics-3e","fox-mcdonald-fluid-mechanics-10e"],"assumptions":["single downstream terminal boundary","steady boundary condition"],"limitations":["control-system dynamics are outside current scope"],"audit":{"sourceOfTruth":"backend","traceBoundary":"nodeResults[sink].results.calculationTrace.boundary/inputBasis with fallback to solved node results","dataStatus":{"status":"available","availableFields":["pressureBarA","elevationM","hydraulicHeadM","demandFlowM3H"],"missingFields":[]},"dependencyKeys":["sink.props.boundaryMode","sink.props.pressure","sink.props.elevation","sink.props.demandFlow"],"staleWhenChanged":["Changing SNK pressure, elevation, demand flow, or attachment invalidates discharge boundary and pump operating point."]},"values":{"pressureBarA":4.935922,"elevationM":8,"hydraulicHeadM":60.154,"demandFlowM3H":39.68}}]},"actionReadinessBackend":{"schemaVersion":"pump-action-readiness.v1","pumpId":"P-100","source":"backend-engine","calculationId":"a3e58122ca340486","generatedAt":"2026-06-03T16:06:28.814Z","backendValidationStatus":"Connected","frontendFallbackAvailable":false,"actions":{"evaluateNpshFromNetwork":{"canRun":true,"status":"Ready","label":"Evaluate NPSH from Network","blockedReasons":[],"warnings":[],"requiredInputs":[],"stale":false,"source":"backend-readiness"},"buildEngineeringFitFromVendorJournalDutyData":{"canRun":true,"status":"Ready","label":"Build Engineering Fit From Vendor/Journal Duty Data","blockedReasons":[],"warnings":[],"requiredInputs":[],"requiresAdvancedMode":false,"source":"backend-readiness"}},"inputMode":"Advanced","routeTraceStatus":"Route complete","isCalculationStale":false,"dependencyFingerprint":"ea128e3fa98ce5bc3dfcdf11dfebb9a0c3c63c0ba45a76b8c363f47c63dad677","routeTraceFingerprint":"19c9b14a62ea3782e1e4df9db9072e179b0da5d73137101afd5be11ee8c07149","resultFingerprint":"a82ff53d4fd7f2990bc6b996f5c63483b340e6311e6001ebb4fa3e75bacda432"},"backendActionReadiness":{"schemaVersion":"pump-action-readiness.v1","pumpId":"P-100","source":"
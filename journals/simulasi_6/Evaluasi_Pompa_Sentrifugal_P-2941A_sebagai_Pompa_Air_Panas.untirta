itting/Valve (discharge)"},{"id":"SNK-100","type":"sink","stage":"SNK"}],"invalidationRules":[{"scope":"Fluid Basis","invalidates":["all route hydraulics","NPSHa","status","exports"]},{"scope":"SRC","invalidates":["suction boundary","suction pressure head","NPSHa"]},{"scope":"Pipe/Fitting/Valve suction","invalidates":["suction loss","NPSHa","pump NPSH margin"]},{"scope":"Pump","invalidates":["operating point","NPSHr","NPSH acceptance","action readiness"]},{"scope":"Pipe/Fitting/Valve discharge","invalidates":["system head","outlet pressure","operating point"]},{"scope":"SNK","invalidates":["discharge boundary","system head","operating point"]}],"staleCalculationPolicy":{"serverAlwaysRecalculates":true,"clientPreviousFingerprintField":"client.previousDependencyFingerprint","staleWhen":"Any Fluid Basis, SRC, suction pipe/fitting/valve, pump, discharge pipe/fitting/valve, SNK, connection, source link, or instrument link input changes.","uiExpectation":"Display the new calculationId and dependencyFingerprint; mark prior UI/export values stale when previousDependencyFingerprint differs."},"softwareDependencyChangeGate":{"schemaVersion":"dependency-change-gate.v1","releaseIntegrityVersion":"release-integrity.v1","watches":["backend calculation engine","route trace schema","formula/literature map","citation page locks","frontend audit bridge","public runtime bundle"],"validationCommand":"node npsh-api/tools/release-integrity-audit.cjs"},"changedInputsFromPrevious":[],"fallbackTraceBoundary":{"policy":"Prefer detailed node calculationTrace; fall back to solved node results only when trace fields are absent.","status":"available"}},"calculationAudit":{"schemaVersion":"calculation-audit.v1","calculationId":"a3e58122ca340486","sourceOfTruth":"backend","calculationFreshness":"Current","auditable":true,"protectedFormulaSource":true,"generatedAt":"2026-06-03T16:06:28.828Z","formulaManifest":{"schemaVersion":"formula-manifest.v1","calculationEngineVersion":"thesis-migration-v0.5.3","routeTraceSchemaVersion":"route-trace.v2","dependencyManifestVersion":"dependency-manifest.v1","protectedSourceOfTruth":"backend","publicFormulaSourceExposed":false,"formulaGroups":["fluid-basis-property-chain","source-boundary-hydraulic-head","darcy-weisbach-pipe-loss","minor-loss-k-method","valve-k-cv-loss","pump-npsh-and-performance","sink-boundary-hydraulic-head","route-trace-status"]},"dependencyManifest":{"schemaVersion":"dependency-manifest.v1","sourceOfTruth":"backend","freshness":"Current","isCalculationStale":false,"priorResultStale":false,"dependencyFingerprint":"ea128e3fa98ce5bc3dfcdf11dfebb9a0c3c63c0ba45a76b8c363f47c63dad677","previousDependencyFingerprint":null,"resultFingerprint":"a82ff53d4fd7f2990bc6b996f5c63483b340e6311e6001ebb4fa3e75bacda432","routeTraceFingerprint":"19c9b14a62ea3782e1e4df9db9072e179b0da5d73137101afd5be11ee8c07149","nodeResultsFingerprint":"a15547442ec5e90d96abaa3a63662f9c825cba6d95d0a42adabd4bb5210ff975","watchedRouteObjects":[{"id":"SRC-100","type":"source","stage":"SRC"},{"id":"PIPE-1","type":"pipe","stage":"Pipe/Fitting/Valve (suction)"},{"id":"P-100","type":"pump","stage":"Pump"},{"id":"PIPE-2","type":"pipe","stage":"Pipe/Fitting/Valve (discharge)"},{"id":"SNK-100","type":"sink","stage":"SNK"}],"invalidationRules":[{"scope":"Fluid Basis","invalidates":["all route hydraulics","NPSHa","status","exports"]},{"scope":"SRC","invalidates":["suction boundary","suction pressure head","NPSHa"]},{"scope":"Pipe/Fitting/Valve suction","invalidates":["suction loss","NPSHa","pump NPSH margin"]},{"scope":"Pump","invalidates":["operating point","NPSHr","NPSH acceptance","action readiness"]},{"scope":"Pipe/Fitting/Valve discharge","invalidates":["system head","outlet pressure","operating point"]},{"scope":"SNK","invalidates":["discharge boundary","system head","operating point"]}],"staleCalculationPolicy":{"serverAlwaysRecalculates":true,"clientPreviousFingerprintField":"client.previousDependencyFingerprint","staleWhen":"Any Fluid Basis, SRC, suction pipe/fitting/valve, pump, discharge pipe/fitting/valve, SNK, connection, source link, or instrument link input changes.","uiExpectation":"Display the new calculationId and dependencyFingerprint; mark prior UI/export values stale when previousDependencyFingerprint differs."},"softwareDependencyChangeGate":{"schemaVersion":"dependency-change-gate.v1","releaseIntegrityVersion":"release-integrity.v1","watches":["backend calculation engine","route trace schema","formula/literature map","citation page locks","frontend audit bridge","public runtime bundle"],"validationCommand":"node npsh-api/tools/release-integrity-audit.cjs"},"changedInputsFromPrevious":[],"fallbackTraceBoundary":{"policy":"Prefer detailed node calculationTrace; fall back to solved node results only when trace fields are absent.","status":"available"}},"fingerprints":{"result":"a82ff53d4fd7f2990bc6b996f5c63483b340e6311e6001ebb4fa3e75bacda432","routeTrace":"19c9b14a62ea3782e1e4df9db9072e179b0da5d73137101afd5be11ee8c07149","nodeResults":"a15547442ec5e90d96abaa3a63662f9c825cba6d95d0a42adabd4bb5210ff975","dependency":"ea128e3fa98ce5bc3dfcdf11dfebb9a0c3c63c0ba45a76b8c363f47c63dad677"}},"calculationDefenseContract":{"schemaVersion":"calculation-defense-contract.v1","sourceOfTruth":"backend","pumpId":"P-100","status":"Ready","freshness":"Current","generatedAt":"2026-06-03T16:06:28.833Z","inputFingerprint":"ea128e3fa98ce5bc3dfcdf11dfebb9a0c3c63c0ba45a76b8c363f47c63dad677","resultFingerprint":"a82ff53d4fd7f2990bc6b996f5c63483b340e6311e6001ebb4fa3e75bacda432","routeTraceFingerprint":"19c9b14a62ea3782e1e4df9db9072e179b0da5d73137101afd5be11ee8c07149","nodeResultsFingerprint":"a15547442ec5e90d96abaa3a63662f9c825cba6d95d0a42adabd4bb5210ff975","formulaDefense":{"schemaVersion":"pump-formula-defense.v1","ready":true,"rowCount":15,"calculationTraceStepCount":14,"rows":[{"order":1,"step":"System Static Head","inputSource":"Resolved suction and discharge boundary heads plus suction/discharge path losses.","formula":"H_static = H_discharge boundary - H_suction boundary","substitution":"60.158 - 22.780 = 37.377 m","result":37.377,"unit":"m","literature":"Fluid Mechanics: Bernoulli/mechanical energy balance and pump/system curve matching.","defenseNote":"Use the formula, substitution, result, and literature basis as the advisor-facing explanation for this number."},{"order":2,"step":"System Curve Head","inputSource":"Resolved suction and discharge boundary heads plus suction/discharge path losses.","formula":"H_system(Q) = H_static + hL_suction(Q) + hL_discharge(Q)","substitution":"37.377 + 0.014 + 0.283 = 37.674 m","result":37.674,"unit":"m","literature":"Fluid Mechanics: Bernoulli/mechanical energy balance and pump/system curve matching.","defenseNote":"Use this to explain why the pump must provide boundary elevation/pressure difference plus suction and discharge losses."},{"order":3,"step":"Head Residual","inputSource":"Pump head curve at evaluated flow and calculated system head at the same flow.","formula":"Head residual = H_pump(Q) - H_system(Q)","substitution":"37.674 - 37.674 = 0.000 m","result":0,"unit":"m","literature":"Fluid Mechanics: Bernoulli/mechanical energy balance and pump/system curve matching.","defenseNote":"Positive residual means pump head is above system demand at that flow; negative residual means the selected curve cannot satisfy the demanded point."},{"order":4,"step":"Source Absolute Pressure","inputSource":"SRC/tank/vessel boundary pressure basis; gauge pressure is converted to absolute pressure.","formula":"Pabs = Pabs input","substitution":"2.024 = 2.024 bar a","result":2.024,"unit":"bar a","literature":"Local thesis literature set: fluid mechanics, cavitation, and ANSI/HI NPSH margin references.","defenseNote":"NPSH uses absolute pressure. Gauge pressure must be converted before pressure-head calculation."},{"order":5,"step":"Pressure Head","inputSource":"Absolute source pressure, active fluid density, and gravitational acceleration.","formula":"Hp = Pabs x 100000 / (rho x g)","substitution":"2.024 x 100000 / (965.000 x 9.810) = 21.380 m","result":21.38,"unit":"m","literature":"Fluid Mechanics: Bernoulli/mechanical energy balance and pump/system curve matching.","defenseNote":"Use the formula, substitution, result, and literature basis as the advisor-facing explanation for this number."},{"order":6,"step":"Elevation Head","inputSource":"Source liquid/boundary elevation and pump suction datum/nozzle elevation.","formula":"Hz = z_source - z_pump","substitution":"1.400 - 0.000 = 1.400 m","result":1.4,"unit":"m","literature":"Fluid Mechanics: Bernoulli/mechanical energy balance and pump/system curve matching.","defenseNote":"Use the formula, substitution, result, and literature basis as the advisor-facing explanation for this number."},{"order":7,"step":"Source Velocity Head","inputSource":"External header static-pressure basis or inlet pipe velocity head; reservoir velocity is normally neglected.","formula":"Hvel = 0","substitution":"0.000 m","result":0,"unit":"m","literature":"Fluid Mechanics: Bernoulli/mechanical energy balance and pump/system curve matching.","defenseNote":"Use the formula, substitution, result, and literature basis as the advisor-facing explanation for this number."},{"order":8,"step":"Suction Loss","inputSource":"Suction-side pipe segments, fittings, valves, roughness, diameter, length, and flow.","formula":"HL = pipe major + fitting/valve minor","substitution":"0.010 + 0.004 = 0.014 m","result":0.014,"unit":"m","literature":"Fluid Mechanics: Darcy-Weisbach major loss plus minor-loss coefficient K; ANSI/HI Appendix A suction head loss hf.","defenseNote":"This is often the easiest engineering lever to improve NPSHa: reduce length, fittings, K value, velocity, or roughness."},{"order":9,"step":"Vapor Pressure Head","inputSource":"Absolute source pressure, active fluid density, and gravitational acceleration.","formula":"Hv = Pv x 100000 / (rho x g)","substitution":"0.701317 x 100000 / (965.000 x 9.810) = 7.408 m","result":7.408,"unit":"m","literature":"Fluid Mechanics: Bernoulli/mechanical energy balance and pump/system curve matching.","defenseNote":"Use the formula, substitution, result, and literature basis as the advisor-facing explanation for this number."},{"order":10,"step":"NPSHa","inputSource":"Calculated suction energy at the pump NPSH datum after suction loss and vapor pressure are subtracted.","formula":"NPSHa = Hp + z_source + Hvel - z_pump - HL - Hv","substitution":"21.380 + 1.400 + 0.000 - 0.000 - 0.014 - 7.408 = 15.358 m","result":15.358,"unit":"m","literature":"ANSI/HI 9.6.1-2024 Appendix A: NPSHA determination at the pump NPSH datum plane.","defenseNote":"NPSHa is system-derived. It can be improved by increasing source pressure/elevation or reducing suction losses/vapor pressure."},{"order":11,"step":"NPSHr","inputSource":"Pump datasheet/manual NPSHr, engineering-fit curve, or manufacturer/test curve at evaluated flow.","formula":"NPSHr = pump required NPSH at operating flow","substitution":"39.680 m3/h -> 1.000 m","result":1,"unit":"m","literature":"ANSI/HI 9.6.1-2024: NPSHR is pump/manufacturer supplied for specified flow, speed, and pumped liquid.","defenseNote":"NPSHr is pump-derived. The network cannot certify it; final validation requires vendor/manufacturer/test or justified journal data."},{"order":12,"step":"Operating Region","inputSource":"Evaluated flow and BEP Flow with configured POR/AOR limits.","formula":"Flow %BEP = Q / Q_BEP x 100","substitution":"39.680 / 180.000 x 100 = 22.044 % BEP","result":22.044,"unit":"% BEP","literature":"ANSI/HI operating-region guidance: POR/AOR are interpreted relative to BEP flow.","defenseNote":"Away from BEP, the application applies AOR logic and the margin basis can become stricter."},{"order":13,"step":"Required NPSHa","inputSource":"Selected NPSH margin basis, margin ratio, absolute margin, NPSHa, and NPSHr.","formula":"Required NPSHa = max(NPSHr x margin ratio, NPSHr + absolute margin)","substitution":"max(1.000 x 1.000, 1.000 + 0.000) = 1.000 m","result":1,"unit":"m","literature":"ANSI/HI 9.6.1-2024: NPSH margin and NPSH margin ratio.","defenseNote":"The application checks both ratio and absolute margin, then uses the stricter required NPSHa."},{"order":14,"step":"Margin and Ratio","inputSource":"Selected NPSH margin basis, margin ratio, absolute margin, NPSHa, and NPSHr.","formula":"Margin = NPSHa - NPSHr; Ratio = NPSHa / NPSHr; Excess = NPSHa - Required NPSHa","substitution":"15.358 - 1.000 = 14.358 m; 15.358 / 1.000 = 15.358; 15.358 - 1.000 = 14.358 m","result":14.358,"unit":"m","literature":"ANSI/HI 9.6.1-2024: NPSH margin and NPSH margin ratio.","defenseNote":"Safe hydraulic margin alone is not enough for thesis validation when NPSHr data confidence is weak."},{"order":15,"step":"Data Confidence Gate","inputSource":"Hydraulic NPSH status, NPSHr source quality, and selected assessment mode.","formula":"Engineering status = hydraulic status + NPSHr data confidence","substitution":"Hydraulic: Safe; Data: Journal gives one calculated operating point plus design/curve comparison data; full digitized manufacturer curve is not supplied.; Engineering: Warning","result":"Warning","unit":"","literature":"ANSI/HI 9.6.1-2024 distinguishes system NPSHA from pump/manufacturer NPSHR; manufacturer/test data is preferred for final validation.","defenseNote":"This is the answer when an advisor asks why a hydraulically safe result may still show Warning in Engineering Validation."}]},"dependencyChange":{"schemaVersion":"dependency-manifest.v1","dependencyFingerprint":"ea128e3fa98ce5bc3dfcdf11dfebb9a0c3c63c0ba45a76b8c363f47c63dad677","previousDependencyFingerprint":null,"priorResultStale":false,"changedInputsInvalidate":"Any Fluid Basis, SRC, suction pipe/fitting/valve, pump, discharge pipe/fitting/valve, SNK, connection, source link, or instrument link input changes."},"dependencyChain":{"ready":true,"chain":["Fluid Basis -> density, viscosity, vapor press
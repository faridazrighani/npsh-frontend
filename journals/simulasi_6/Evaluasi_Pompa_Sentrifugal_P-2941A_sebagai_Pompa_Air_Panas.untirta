"frictionFactor":0.030369},{"reynolds":85151329,"frictionFactor":0.030369},{"reynolds":100000000,"frictionFactor":0.030368}]}],"markers":[{"index":0,"name":"Suction equivalent length NPS 8 Sch 40","reynolds":208787,"frictionFactor":0.017167,"relRoughness":0.00022556,"flowRegime":"Turbulent","diameter":0.2027,"effectiveRoughness":0.00004572},{"index":1,"name":"Suction strainer journal loss","reynolds":208787,"frictionFactor":0.017167,"relRoughness":0.00022556,"flowRegime":"Turbulent","diameter":0.2027,"effectiveRoughness":0.00004572}],"isSolved":true,"note":"Darcy friction factor chart. Fanning friction factor equals Darcy f / 4."},"segments":[{"index":0,"name":"Suction equivalent length NPS 8 Sch 40","componentType":"Valve / inline component","fittingType":"None","fittingQuantity":0,"kEach":0,"totalK":0,"sourceNote":"Journal suction equivalent length: NPS 8 Sch 40, total Lt = 19.56 m including pipe, tee, gate valve, eccentric reducer, and inlet.","notes":"Journal suction equivalent length: NPS 8 Sch 40, total Lt = 19.56 m including pipe, tee, gate valve, eccentric reducer, and inlet.","flowRegime":"Turbulent","warning":"","dataSources":{"size":{"status":"User","source":"User-entered internal diameter"},"material":{"status":"User","source":"User-entered roughness"},"fitting":{"status":"Exact","source":"No local fitting loss"}},"profile":{"index":0,"name":"Suction equivalent length NPS 8 Sch 40","startElevation":1.4,"endElevation":0,"startPressure":2.023,"endPressure":2.155,"startHead":22.78,"endHead":22.771,"highPointElevation":null,"highPointLocationPercent":null,"highPointBasis":"","highPointPressure":null,"highPointVaporMargin":null},"steps":[{"title":"Area","formula":"A = pi x D^2 / 4","substitution":"pi x 0.2027^2 / 4 = 0.0323 m2","result":0.03227,"unit":"m2","reference":"Circular pipe cross-sectional area"},{"title":"Velocity","formula":"V = Q / A","substitution":"0.011022 / 0.03227 = 0.3416 m/s","result":0.341564,"unit":"m/s","reference":"Average pipe velocity"},{"title":"Reynolds Number","formula":"Re = V x D / nu","substitution":"0.3416 x 0.2027 / 3.3161e-7 = 2.0879e+5","result":208786.718088,"unit":"","reference":"Pipe flow regime basis"},{"title":"Effective Roughness","formula":"eps_eff = eps x aging factor","substitution":"4.5720e-5 x 1 = 4.5720e-5 m","result":0.000046,"unit":"m","reference":"Aging/degradation screening"},{"title":"Relative Roughness","formula":"eps_eff / D","substitution":"4.5720e-5 / 0.2027 = 0.000226","result":0.000226,"unit":"","reference":"Moody/Colebrook roughness input"},{"title":"Darcy Friction Factor","formula":"1/sqrt(f) = -2 log10(eps/(3.7D) + 2.51/(Re sqrt(f)))","substitution":"Re = 2.0879e+5; eps/D = 0.000226; regime = Turbulent; f = 0.017167","result":0.017167,"unit":"","reference":"Darcy f from laminar equation, Colebrook/Moody turbulent basis, or transitional blend warning"},{"title":"Velocity Head","formula":"hv = V^2 / (2g)","substitution":"0.3416^2 / (2 x 9.81) = 0.0059 m","result":0.005946,"unit":"m","reference":"Dynamic head term"},{"title":"Major Loss","formula":"h_major = f x (L / D) x hv","substitution":"0.017167 x (19.56 / 0.2027) x 0.0059 = 0.0099 m","result":0.00985,"unit":"m","reference":"Darcy-Weisbach pipe friction"},{"title":"Minor Loss","formula":"h_minor = K_total x hv","substitution":"0 x 0.0059 = 0 m","result":0,"unit":"m","reference":"Fitting and additional K loss"},{"title":"Allowance Loss","formula":"h_allow = (h_major + h_minor) x allowance","substitution":"(0.0099 + 0) x 0 = 0 m","result":0,"unit":"m","reference":"Fouling/design allowance"},{"title":"Segment Total Loss","formula":"h_total = h_major + h_minor + h_allow","substitution":"0.0099 + 0 + 0 = 0.0099 m","result":0.00985,"unit":"m","reference":"Segment loss contribution"}],"pressureSteps":[{"title":"Segment Inlet Pressure","formula":"P_in = rho x g x (H_in - z_in - hv) / 100000","substitution":"2.023 bar a","result":2.023,"unit":"bar a","reference":"Static pressure from hydraulic head"},{"title":"Segment Outlet Pressure","formula":"P_out = rho x g x (H_out - z_out - hv) / 100000","substitution":"2.155 bar a","result":2.155,"unit":"bar a","reference":"Static pressure after segment loss"}]},{"index":1,"name":"Suction strainer journal loss","componentType":"Inline component","fittingType":"Custom K","fittingQuantity":1,"kEach":0.697917,"totalK":0.697917,"sourceNote":"Equivalent K selected from the journal strainer loss hstr = 0.00415 m at Q = 39.68 m3/h.","notes":"Equivalent K selected from the journal strainer loss hstr = 0.00415 m at Q = 39.68 m3/h.","flowRegime":"Turbulent","warning":"","dataSources":{"size":{"status":"User","source":"User-entered internal diameter"},"material":{"status":"User","source":"User-entered roughness"},"fitting":{"status":"User","source":"User-entered loss coefficient"}},"profile":{"index":1,"name":"Suction strainer journal loss","startElevation":0,"endElevation":0,"startPressure":2.155,"endPressure":2.155,"startHead":22.771,"endHead":22.766,"highPointElevation":null,"highPointLocationPercent":null,"highPointBasis":"","highPointPressure":null,"highPointVaporMargin":null},"steps":[{"title":"Area","formula":"A = pi x D^2 / 4","substitution":"pi x 0.2027^2 / 4 = 0.0323 m2","result":0.03227,"unit":"m2","reference":"Circular pipe cross-sectional area"},{"title":"Velocity","formula":"V = Q / A","substitution":"0.011022 / 0.03227 = 0.3416 m/s","result":0.341564,"unit":"m/s","reference":"Average pipe velocity"},{"title":"Reynolds Number","formula":"Re = V x D / nu","substitution":"0.3416 x 0.2027 / 3.3161e-7 = 2.0879e+5","result":208786.718088,"unit":"","reference":"Pipe flow regime basis"},{"title":"Effective Roughness","formula":"eps_eff = eps x aging factor","substitution":"4.5720e-5 x 1 = 4.5720e-5 m","result":0.000046,"unit":"m","reference":"Aging/degradation screening"},{"title":"Relative Roughness","formula":"eps_eff / D","substitution":"4.5720e-5 / 0.2027 = 0.000226","result":0.000226,"unit":"","reference":"Moody/Colebrook roughness input"},{"title":"Darcy Friction Factor","formula":"1/sqrt(f) = -2 log10(eps/(3.7D) + 2.51/(Re sqrt(f)))","substitution":"Re = 2.0879e+5; eps/D = 0.000226; regime = Turbulent; f = 0.017167","result":0.017167,"unit":"","reference":"Darcy f from laminar equation, Colebrook/Moody turbulent basis, or transitional blend warning"},{"title":"Velocity Head","formula":"hv = V^2 / (2g)","substitution":"0.3416^2 / (2 x 9.81) = 0.0059 m","result":0.005946,"unit":"m","reference":"Dynamic head term"},{"title":"Major Loss","formula":"h_major = f x (L / D) x hv","substitution":"0.017167 x (0 / 0.2027) x 0.0059 = 0 m","result":0,"unit":"m","reference":"Darcy-Weisbach pipe friction"},{"title":"Minor Loss","formula":"h_minor = K_total x hv","substitution":"0.6979 x 0.0059 = 0.0042 m","result":0.00415,"unit":"m","reference":"Fitting and additional K loss"},{"title":"Allowance Loss","formula":"h_allow = (h_major + h_minor) x allowance","substitution":"(0 + 0.0042) x 0 = 0 m","result":0,"unit":"m","reference":"Fouling/design allowance"},{"title":"Segment Total Loss","formula":"h_total = h_major + h_minor + h_allow","substitution":"0 + 0.0042 + 0 = 0.0042 m","result":0.00415,"unit":"m","reference":"Segment loss contribution"}],"pressureSteps":[{"title":"Segment Inlet Pressure","formula":"P_in = rho x g x (H_in - z_in - hv) / 100000","substitution":"2.155 bar a","result":2.155,"unit":"bar a","reference":"Static pressure from hydraulic head"},{"title":"Segment Outlet Pressure","formula":"P_out = rho x g x (H_out - z_out - hv) / 100000","substitution":"2.155 bar a","result":2.155,"unit":"bar a","reference":"Static pressure after segment loss"}]}],"fittingValveBreakdown":[{"index":0,"name":"Suction equivalent length NPS 8 Sch 40","componentType":"Valve / inline component","fittingType":"None","quantity":0,"kEach":0,"fittingTotalK":0,"additionalK":0,"totalK":0,"majorLoss":0.00985,"fittingLoss":0,"additionalLoss":0,"minorLoss":0,"allowanceLoss":0,"totalLoss":0.00985,"dataBasis":"User / User / Exact","sourceNote":"Journal suction equivalent length: NPS 8 Sch 40, total Lt = 19.56 m including pipe, tee, gate valve, eccentric reducer, and inlet."},{"index":1,"name":"Suction strainer journal loss","componentType":"Inline component","fittingType":"Custom K","quantity":1,"kEach":0.697917,"fittingTotalK":0.697917,"additionalK":0,"totalK":0.697917,"majorLoss":0,"fittingLoss":0.00415,"additionalLoss":0,"minorLoss":0.00415,"allowanceLoss":0,"totalLoss":0.00415,"dataBasis":"User / User / User","sourceNote":"Equivalent K selected from the journal strainer loss hstr = 0.00415 m at Q = 39.68 m3/h."}],"pumpPathRole":{"pumpId":"P-100","role":"Suction path","impact":"Reduces NPSHa","calculationUse":"Total pipe loss is subtracted from suction boundary head before pump suction NPSHa is calculated.","basis":"Solved hydraulic network state","rows":[{"pumpId":"P-100","role":"Suction path","impact":"Reduces NPSHa","calculationUse":"Total pipe loss is subtracted from suction boundary head before pump suction NPSHa is calculated.","basis":"Solved hydraulic network state"}]},"dependencyChain":["Connected hydraulic path provides the solved flow for each pipe segment.","Pipe geometry and flow determine cross-sectional area, velocity, and velocity head.","Fluid basis and pipe geometry determine Reynolds number and flow regime.","Pipe roughness and flow regime determine friction factor.","Pipe length and friction factor determine major loss.","Fittings, valves, strainers, and custom K values determine minor loss.","Major and minor losses are combined into segment loss.","Segment losses are summed into total pipe/path loss.","Suction path loss affects pump suction pressure and NPSHₐ.","Discharge path loss affects required system head and downstream pressure."],"sourceMap":[{"parameter":"Flow","value":39.68,"unit":"m3/h","status":"Network-derived","method":"Solved solid hydraulic pipe path","formula":"Q_m3/s = Q_m3/h / 3600","reference":"Hydraulic network flow balance"},{"parameter":"Flow conversion","value":0.01102222,"unit":"m3/s","status":"Formula verified","method":"Unit conversion","formula":"Q = flow / 3600","reference":"SI unit conversion"},{"parameter":"Density","value":965,"unit":"kg/m3","status":"Fluid Basis","method":"Active Fluid Basis property","formula":"rho = Fluid Basis density","reference":"Required for pressure/head conversion"},{"parameter":"Kinematic viscosity","value":0.331606,"unit":"cSt","status":"Fluid Basis","method":"Active Fluid Basis property","formula":"nu = cSt x 1e-6 m2/s","reference":"Required for Reynolds number"},{"parameter":"Vapor pressure","value":0.701317,"unit":"bar a","status":"Fluid Basis","method":"Active Fluid Basis absolute vapor pressure","formula":"Margin = P_high_point - P_vapor","reference":"Required for high point and NPSH screening"},{"parameter":"Pipe Pressure","value":2.089,"unit":"bar a","status":"Network-derived realtime","method":"Live pipe mid-point static pressure readout","formula":"P_pipe = pressureHeadToBar(H_mid - z_mid - V^2/2g, rho)","reference":"Same value source as Pipe Object Properties > Pipe Pressure"},{"parameter":"Inlet Pressure","value":2.023,"unit":"bar a","status":"Network-derived realtime","method":"Live pipe inlet static pressure readout","formula":"P_in = pressureHeadToBar(H_in - z_in - V^2/2g, rho)","reference":"Same value source as Pipe Object Properties > Inlet Pressure"},{"parameter":"Outlet Pressure","value":2.155,"unit":"bar a","status":"Network-derived realtime","method":"Live pipe outlet static pressure readout","formula":"P_out = pressureHeadToBar(H_out - z_out - V^2/2g, rho)","reference":"Same value source as Pipe Object Properties > Outlet Pressure"},{"parameter":"Pump Path Role","value":"Suction path","unit":"","status":"P-100","method":"Solved hydraulic network state","formula":"role = pipeId in suctionPath.steps or dischargePath.steps","reference":"Suction path reduces NPSHa; discharge path adds required pump head"},{"parameter":"Pump Calculation Impact","value":"Reduces NPSHa","unit":"","status":"Suction path","method":"Total pipe loss is subtracted from suction boundary head before pump suction NPSHa is calculated.","formula":"NPSHa = H_suction_boundary - hL_suction - z_pump - H_vapor","reference":"Pipe role interpretation from solved pump hydraulic path"},{"parameter":"Endpoint elevation rule","value":"Start -> inlet/profile; End -> outlet","unit":"","status":"Engineering interpretation","method":"Pipe endpoint elevations are pressure-profile terms, not independent boundary energy sources","formula":"P_in uses z_start; P_out uses z_end; high point uses local z","reference":"Bernoulli elevation head term; change SRC/tank/vessel elevation to change source head"},{"parameter":"Pipe size / ID","value":0.2027,"unit":"m","status":"User","method":"User-entered internal diameter","formula":"A = pi D^2 / 4","reference":"ASME/custom diameter basis; verify project piping class"},{"parameter":"Roughness","value":0.00004572,"unit":"m","status":"User","method":"User-entered roughness","formula":"eps_eff = eps x aging factor","reference":"Moody/Colebrook roughness input"},{"parameter":"Fitting K","value":0.697917,"unit":"","status":"All segments","method":"Sum of segment fitting/additional K values","formula":"h_minor,total = sum(K_total,i x V_i^2/(2g))","reference":"All Segment Calculation Trace shows segment-by-segment K; avoid double counting with valve objects"},{"parameter":"Head loss allowance","value":0,"unit":"%","status":"Not applied","method":"Optional design/fouling allowance","formula":"h_allow = (h_major + h_minor) x allowance","reference":"Engineering screening factor"},{"parameter":"Pressure profile","value":"Available","unit":"","status":"Network-derived","method":"Static pressure from hydraulic head balance","formula":"P = rho g (H - z - V^2/2g) / 100000","reference":"Used for inlet/outlet and high point vapor margin"}],"warnings":[],"references":["pdf_ref/ref1-fluid-mechanics-fundaments-and-applications.pdf: internal pipe flow, Reynolds number, Darcy-Weisbach loss, Moody/Colebrook friction, and minor-loss coefficients.","pdf_ref/ref2-introduction-fluid-mechanics.pdf: steady-flow energy equation, pipe friction, and head-loss terms.","pdf_ref/ref4-standar_ANSI-9-6-2024_rotodynamic_pump_guidline_for_NPSH_margin-hydraulic-institute.pdf: suction line losses and NPSHA margin context.","NASA Glenn Bernoulli equation: static pressure plus dynamic pressure/head interpretation for steady inviscid reference.","NIST SI Guide: pressure unit pascal and coherent SI unit conversions used for pressure/head checks."],"notes":["Friction factor shown is Darcy f, not Fanning f.","Fluid viscosity basis is kinematic viscosity in cSt.","Pipe size, roughness, and fitting K defaults are reference/typical engineering values unless marked User or Estimate."],"engineeringLimitations":["Pressure used for NPSH and vapor-pressure checks must be absolute pressure (bar a). Gauge inputs must be converted at the boundary.","Elevation datum must be consistent between source/sink boundaries, pipe endpoints, high points, and pump nozzles.","Roughness, aging factor, and head-loss allowance are engineering inputs that can materially change the system curve and NPSHa.","Fitting K values can vary by geometry and vendor; typical values are screening inputs until replaced by project/vendor data.","Valve Object losses and valve-like pipe fitting K values should not be counted twice.","Transitional Reynolds-number results are approximate and should be treated as review/warning conditions.","High point vapor margin is a steady-state single-phase screen; it does not model transient, water hammer, flashing, two-phase flow, or gas entrainment."],"formulaDefenseRows":[{"step":"Short Answer for Advisor","inputSource":"Current Pipe Object Properties and solved hydraulic network.","formula":"Darcy-Weisbach major loss + K-method minor loss","substitution":"The pipe uses solved flow, active Fluid Basis, pipe ID, roughness, length, fittings, and elevation profile.","result":"Pipe hydraulic loss trace is available.","literatureBasis":"Fluid mechanics pipe-flow literature and ANSI/HI NPSH suction-loss context.","advisorDefenseNote":"The pipe model is a steady-state, single-phase, incompressible hydraulic calculation, not a transient/two-phase model."},{"step":"Flow Conversion","inputSource":"Solved network flow through the solid hydraulic pipe path.","formula":"Q = flow / 3600","substitution":"39.68 / 3600 = 0.01102222","result":"0.01102222 m3/s","literatureBasis":"SI flow-unit conversion before velocity and Reynolds number.","advisorDefenseNote":"All subsequent pipe equations use SI base units."},{"step":"Pipe Area","inputSource":"Suction equivalent length NPS 8 Sch 40: pipe size/custom ID source.","formula":"A = pi x D^2 / 4","substitution":"pi x 0.2027^2 / 4 = 0.0323 m2","result":"0.0323 m2","literatureBasis":"Circular pipe geometry.","advisorDefenseNote":"Diameter must follow project piping class or documented custom internal diameter."},{"step":"Velocity","inputSource":"Converted flow and pipe area.","formula":"V = Q / A","substitution":"0.011022 / 0.03227 = 0.3416 m/s","result":"0.3416 m/s","literatureBasis":"Continuity equation.","advisorDefenseNote":"Velocity drives dynamic head, Reynolds number, major loss, and minor loss."},{"step":"Reynolds Number","inputSource":"Velocity, pipe ID, and Fluid Basis kinematic viscosity.","formula":"Re = V x D / nu","substitution":"0.3416 x 0.2027 / 3.3161e-7 = 2.0879e+5","result":"2.0879e+5","literatureBasis":"Internal-flow regime criterion.","advisorDefenseNote":"Laminar, transitional, or turbulent regime determines how friction factor is defended."},{"step":"Darcy Friction Factor","inputSource":"Reynolds number plus effective relative roughness.","formula":"1/sqrt(f) = -2 log10(eps/(3.7D) + 2.51/(Re sqrt(f)))","substitution":"Re = 2.0879e+5; eps/D = 0.000226; regime = Turbulent; f = 0.017167","result":"0.017167","literatureBasis":"Laminar f=64/Re; turbulent Colebrook/Moody; transitional warning band.","advisorDefenseNote":"The application reports Darcy f, not Fanning f."},{"step":"Major Loss","inputSource":"All pipe segments: friction factor, length, diameter, and velocity head.","formula":"h_major,total = sum[f_i x (L_i / D_i) x V_i^2/(2g)]","substitution":"0.0098 + 0 = 0.0098 m","result":"0.0098 m","literatureBasis":"Darcy-Weisbach equation.","advisorDefenseNote":"This total matches Pipe Object Properties > Major Loss; segment-level details remain in All Segment Calculation Trace."},{"step":"Minor Loss","inputSource":"All pipe segments: fitting/valve K, quantity, and Add K entries.","formula":"h_minor,total = sum(K_total,i x V_i^2/(2g))","substitution":"0 + 0.0042 = 0.0042 m","result":"0.0042 m","literatureBasis":"K-method for fittings, entrances, exits, reducers, strainers, and valve-like losses.","advisorDefenseNote":"This total matches Pipe Object Properties > Minor Loss; K values are typical/user/vendor data depending on source, and separate Valve Object losses must not be counted again here."},{"step":"Allowance and Total Loss","inputSource":"Major loss, minor loss, and optional head-loss allowance.","formula":"h_total = h_major + h_minor + h_allow","substitution":"0.0098 + 0.0042 + 0 = 0.014 m","result":"0.014 m","literatureBasis":"Total line loss used by hydraulic energy balance.","advisorDefenseNote":"Suction-side total loss subtracts from NPSHa; discharge-side total loss increases required pump head/system curve."},{"step":"Endpoint Pressure Elevation Rule","inputSource":"Pipe endpoint elevations, solved hydraulic heads, and velocity heads.","formula":"P_in = rho g(H_in - z_start - V_in^2/2g)/100000; P_out = rho g(H_out - z_end - V_out^2/2g)/100000","substitution":"z_start=1.4 m, z_end=0 m, P_in=2.023 bar a, P_out=2.155 bar a","result":"Outlet pressure follows z_end and solved H_out: 2.155 bar a","literatureBasis":"Bernoulli equation: static pressure is hydraulic head minus elevation head and velocity head.","advisorDefenseNote":"Changing Start Elevation Override affects inlet/profile pressure. Outlet Pressure changes when End Elevation Override, outlet hydraulic head, flow/velocity, or boundary conditions change."}]}}},"P-100":{"type":"pump","name":"P-2941 A","props":{"inputMode":"Advanced","optimizationMode":"Manual","npshrSourceMode":"Manufacturer/Test Curve","curveDataSource":"Engineering Fit","curveSourceNote":"Operating point, design point, efficiency, and NPSHr are taken from the journal tables and curve discussion. The calculated operating head is used for hydraulic closure; the manufacturer curve read-off at the same flow is recorded in validationAudit.","curveGeneratedByEngineeringFit":true,"curveFitCompleteness":"Journal gives one calculated operating point plus design/curve comparison data; full digitized manufacturer curve is not supplied.","curveFitAssumptions":"Active validation point is Q = 39.68 m3/h and H = 37.674 m from the journal calculation. Curve read-off at this flow is 36 m.","curveFitNpshrBasis":"NPSHr = 1 m from the curve at current operating flow; design NPSHr = 1.6 m.","npshAssessmentMode":"Engineering Validation","npshMarginBasis":"User Defined","screeningDefaultsApplied":false,"elevation":0,"suctionElevation":0,"dischargeElevation":0,"designFlow":150,"designHead":30,"designEfficiency":62,"designNpshr":1.6,"bepFlow":180,"porMinPercent":70,"porMaxPercent":120,"aorMinPercent":20,"aorMaxPercent":130,"minNpshMarginRatio":1,"minNpshMargin":0,"journalPumpTag":"P-2941 A","journalService":"Hot water from TK-2941 to reactor jacket","journalTemperatureC":90,"journalDesignFlowM3H":150,"journalDesignHeadM":30,"journalDesignEfficiencyPercent":62,"journalDesignNpshrM":1.6,"journalDesignPumpPowerKw":19,"journalDesignMotorPowerKw":30,"journalOperatingFlowM3H":39.68,"journalOperatingHeadM":37.674,"journalOperatingEfficiencyPercent":30,"journalOperatingPumpPowerKw":13.007,"journalCalculatedShaftPowerKw":13.077,"journalMotorPowerKw":15.039,"journalCurveHe
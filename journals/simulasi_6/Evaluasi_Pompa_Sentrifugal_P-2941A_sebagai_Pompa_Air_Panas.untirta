reynolds":4016322,"frictionFactor":0.030392},{"reynolds":4716688,"frictionFactor":0.030388},{"reynolds":5539183,"frictionFactor":0.030385},{"reynolds":6505105,"frictionFactor":0.030383},{"reynolds":7639463,"frictionFactor":0.03038},{"reynolds":8971631,"frictionFactor":0.030378},{"reynolds":10536103,"frictionFactor":0.030377},{"reynolds":12373386,"frictionFactor":0.030375},{"reynolds":14531055,"frictionFactor":0.030374},{"reynolds":17064977,"frictionFactor":0.030373},{"reynolds":20040764,"frictionFactor":0.030372},{"reynolds":23535469,"frictionFactor":0.030372},{"reynolds":27639579,"frictionFactor":0.030371},{"reynolds":32459363,"frictionFactor":0.03037},{"reynolds":38119621,"frictionFactor":0.03037},{"reynolds":44766912,"frictionFactor":0.03037},{"reynolds":52573358,"frictionFactor":0.030369},{"reynolds":61741089,"frictionFactor":0.030369},{"reynolds":72507488,"frictionFactor":0.030369},{"reynolds":85151329,"frictionFactor":0.030369},{"reynolds":100000000,"frictionFactor":0.030368}]}],"markers":[{"index":0,"name":"Discharge equivalent length NPS 6 Sch 40","reynolds":274634,"frictionFactor":0.017099,"relRoughness":0.00029669,"flowRegime":"Turbulent","diameter":0.1541,"effectiveRoughness":0.00004572}],"isSolved":true,"note":"Darcy friction factor chart. Fanning friction factor equals Darcy f / 4."},"segments":[{"index":0,"name":"Discharge equivalent length NPS 6 Sch 40","componentType":"Valve / inline component","fittingType":"None","fittingQuantity":0,"kEach":0,"totalK":0,"sourceNote":"Journal discharge equivalent length: NPS 6 Sch 40, total Lt = 143.02 m including pipe, L.R. elbow 90, reducer, 75% gate valve, check valve, and tee.","notes":"Journal discharge equivalent length: NPS 6 Sch 40, total Lt = 143.02 m including pipe, L.R. elbow 90, reducer, 75% gate valve, check valve, and tee.","flowRegime":"Turbulent","warning":"","dataSources":{"size":{"status":"User","source":"User-entered internal diameter"},"material":{"status":"User","source":"User-entered roughness"},"fitting":{"status":"Exact","source":"No local fitting loss"}},"profile":{"index":0,"name":"Discharge equivalent length NPS 6 Sch 40","startElevation":0,"endElevation":8,"startPressure":5.72,"endPressure":4.936,"startHead":60.44,"endHead":60.158,"highPointElevation":null,"highPointLocationPercent":null,"highPointBasis":"","highPointPressure":null,"highPointVaporMargin":null},"steps":[{"title":"Area","formula":"A = pi x D^2 / 4","substitution":"pi x 0.1541^2 / 4 = 0.0187 m2","result":0.018651,"unit":"m2","reference":"Circular pipe cross-sectional area"},{"title":"Velocity","formula":"V = Q / A","substitution":"0.011022 / 0.018651 = 0.591 m/s","result":0.590982,"unit":"m/s","reference":"Average pipe velocity"},{"title":"Reynolds Number","formula":"Re = V x D / nu","substitution":"0.591 x 0.1541 / 3.3161e-7 = 2.7463e+5","result":274633.794655,"unit":"","reference":"Pipe flow regime basis"},{"title":"Effective Roughness","formula":"eps_eff = eps x aging factor","substitution":"4.5720e-5 x 1 = 4.5720e-5 m","result":0.000046,"unit":"m","reference":"Aging/degradation screening"},{"title":"Relative Roughness","formula":"eps_eff / D","substitution":"4.5720e-5 / 0.1541 = 0.000297","result":0.000297,"unit":"","reference":"Moody/Colebrook roughness input"},{"title":"Darcy Friction Factor","formula":"1/sqrt(f) = -2 log10(eps/(3.7D) + 2.51/(Re sqrt(f)))","substitution":"Re = 2.7463e+5; eps/D = 0.000297; regime = Turbulent; f = 0.017099","result":0.017099,"unit":"","reference":"Darcy f from laminar equation, Colebrook/Moody turbulent basis, or transitional blend warning"},{"title":"Velocity Head","formula":"hv = V^2 / (2g)","substitution":"0.591^2 / (2 x 9.81) = 0.0178 m","result":0.017801,"unit":"m","reference":"Dynamic head term"},{"title":"Major Loss","formula":"h_major = f x (L / D) x hv","substitution":"0.017099 x (143.02 / 0.1541) x 0.0178 = 0.2825 m","result":0.282501,"unit":"m","reference":"Darcy-Weisbach pipe friction"},{"title":"Minor Loss","formula":"h_minor = K_total x hv","substitution":"0 x 0.0178 = 0 m","result":0,"unit":"m","reference":"Fitting and additional K loss"},{"title":"Allowance Loss","formula":"h_allow = (h_major + h_minor) x allowance","substitution":"(0.2825 + 0) x 0 = 0 m","result":0,"unit":"m","reference":"Fouling/design allowance"},{"title":"Segment Total Loss","formula":"h_total = h_major + h_minor + h_allow","substitution":"0.2825 + 0 + 0 = 0.2825 m","result":0.282501,"unit":"m","reference":"Segment loss contribution"}],"pressureSteps":[{"title":"Segment Inlet Pressure","formula":"P_in = rho x g x (H_in - z_in - hv) / 100000","substitution":"5.72 bar a","result":5.72,"unit":"bar a","reference":"Static pressure from hydraulic head"},{"title":"Segment Outlet Pressure","formula":"P_out = rho x g x (H_out - z_out - hv) / 100000","substitution":"4.936 bar a","result":4.936,"unit":"bar a","reference":"Static pressure after segment loss"}]}],"fittingValveBreakdown":[{"index":0,"name":"Discharge equivalent length NPS 6 Sch 40","componentType":"Valve / inline component","fittingType":"None","quantity":0,"kEach":0,"fittingTotalK":0,"additionalK":0,"totalK":0,"majorLoss":0.282501,"fittingLoss":0,"additionalLoss":0,"minorLoss":0,"allowanceLoss":0,"totalLoss":0.282501,"dataBasis":"User / User / Exact","sourceNote":"Journal discharge equivalent length: NPS 6 Sch 40, total Lt = 143.02 m including pipe, L.R. elbow 90, reducer, 75% gate valve, check valve, and tee."}],"pumpPathRole":{"pumpId":"P-100","role":"Discharge path","impact":"Adds required pump head","calculationUse":"Total pipe loss is added to the discharge side of required pump head and system curve.","basis":"Solved hydraulic network state","rows":[{"pumpId":"P-100","role":"Discharge path","impact":"Adds required pump head","calculationUse":"Total pipe loss is added to the discharge side of required pump head and system curve.","basis":"Solved hydraulic network state"}]},"dependencyChain":["Connected hydraulic path provides the solved flow for each pipe segment.","Pipe geometry and flow determine cross-sectional area, velocity, and velocity head.","Fluid basis and pipe geometry determine Reynolds number and flow regime.","Pipe roughness and flow regime determine friction factor.","Pipe length and friction factor determine major loss.","Fittings, valves, strainers, and custom K values determine minor loss.","Major and minor losses are combined into segment loss.","Segment losses are summed into total pipe/path loss.","Suction path loss affects pump suction pressure and NPSHₐ.","Discharge path loss affects required system head and downstream pressure."],"sourceMap":[{"parameter":"Flow","value":39.68,"unit":"m3/h","status":"Network-derived","method":"Solved solid hydraulic pipe path","formula":"Q_m3/s = Q_m3/h / 3600","reference":"Hydraulic network flow balance"},{"parameter":"Flow conversion","value":0.01102222,"unit":"m3/s","status":"Formula verified","method":"Unit conversion","formula":"Q = flow / 3600","reference":"SI unit conversion"},{"parameter":"Density","value":965,"unit":"kg/m3","status":"Fluid Basis","method":"Active Fluid Basis property","formula":"rho = Fluid Basis density","reference":"Required for pressure/head conversion"},{"parameter":"Kinematic viscosity","value":0.331606,"unit":"cSt","status":"Fluid Basis","method":"Active Fluid Basis property","formula":"nu = cSt x 1e-6 m2/s","reference":"Required for Reynolds number"},{"parameter":"Vapor pressure","value":0.701317,"unit":"bar a","status":"Fluid Basis","method":"Active Fluid Basis absolute vapor pressure","formula":"Margin = P_high_point - P_vapor","reference":"Required for high point and NPSH screening"},{"parameter":"Pipe Pressure","value":5.328,"unit":"bar a","status":"Network-derived realtime","method":"Live pipe mid-point static pressure readout","formula":"P_pipe = pressureHeadToBar(H_mid - z_mid - V^2/2g, rho)","reference":"Same value source as Pipe Object Properties > Pipe Pressure"},{"parameter":"Inlet Pressure","value":5.72,"unit":"bar a","status":"Network-derived realtime","method":"Live pipe inlet static pressure readout","formula":"P_in = pressureHeadToBar(H_in - z_in - V^2/2g, rho)","reference":"Same value source as Pipe Object Properties > Inlet Pressure"},{"parameter":"Outlet Pressure","value":4.936,"unit":"bar a","status":"Network-derived realtime","method":"Live pipe outlet static pressure readout","formula":"P_out = pressureHeadToBar(H_out - z_out - V^2/2g, rho)","reference":"Same value source as Pipe Object Properties > Outlet Pressure"},{"parameter":"Pump Path Role","value":"Discharge path","unit":"","status":"P-100","method":"Solved hydraulic network state","formula":"role = pipeId in suctionPath.steps or dischargePath.steps","reference":"Suction path reduces NPSHa; discharge path adds required pump head"},{"parameter":"Pump Calculation Impact","value":"Adds required pump head","unit":"","status":"Discharge path","method":"Total pipe loss is added to the discharge side of required pump head and system curve.","formula":"H_required = delta boundary head + hL_suction + hL_discharge","reference":"Pipe role interpretation from solved pump hydraulic path"},{"parameter":"Endpoint elevation rule","value":"Start -> inlet/profile; End -> outlet","unit":"","status":"Engineering interpretation","method":"Pipe endpoint elevations are pressure-profile terms, not independent boundary energy sources","formula":"P_in uses z_start; P_out uses z_end; high point uses local z","reference":"Bernoulli elevation head term; change SRC/tank/vessel elevation to change source head"},{"parameter":"Pipe size / ID","value":0.1541,"unit":"m","status":"User","method":"User-entered internal diameter","formula":"A = pi D^2 / 4","reference":"ASME/custom diameter basis; verify project piping class"},{"parameter":"Roughness","value":0.00004572,"unit":"m","status":"User","method":"User-entered roughness","formula":"eps_eff = eps x aging factor","reference":"Moody/Colebrook roughness input"},{"parameter":"Fitting K","value":0,"unit":"","status":"Exact","method":"No local fitting loss","formula":"h_minor,total = sum(K_total,i x V_i^2/(2g))","reference":"All Segment Calculation Trace shows segment-by-segment K; avoid double counting with valve objects"},{"parameter":"Head loss allowance","value":0,"unit":"%","status":"Not applied","method":"Optional design/fouling allowance","formula":"h_allow = (h_major + h_minor) x allowance","reference":"Engineering screening factor"},{"parameter":"Pressure profile","value":"Available","unit":"","status":"Network-derived","method":"Static pressure from hydraulic head balance","formula":"P = rho g (H - z - V^2/2g) / 100000","reference":"Used for inlet/outlet and high point vapor margin"}],"warnings":[],"references":["pdf_ref/ref1-fluid-mechanics-fundaments-and-applications.pdf: internal pipe flow, Reynolds number, Darcy-Weisbach loss, Moody/Colebrook friction, and minor-loss coefficients.","pdf_ref/ref2-introduction-fluid-mechanics.pdf: steady-flow energy equation, pipe friction, and head-loss terms.","pdf_ref/ref4-standar_ANSI-9-6-2024_rotodynamic_pump_guidline_for_NPSH_margin-hydraulic-institute.pdf: suction line losses and NPSHA margin context.","NASA Glenn Bernoulli equation: static pressure plus dynamic pressure/head interpretation for steady inviscid reference.","NIST SI Guide: pressure unit pascal and coherent SI unit conversions used for pressure/head checks."],"notes":["Friction factor shown is Darcy f, not Fanning f.","Fluid viscosity basis is kinematic viscosity in cSt.","Pipe size, roughness, and fitting K defaults are reference/typical engineering values unless marked User or Estimate."],"engineeringLimitations":["Pressure used for NPSH and vapor-pressure checks must be absolute pressure (bar a). Gauge inputs must be converted at the boundary.","Elevation datum must be consistent between source/sink boundaries, pipe endpoints, high points, and pump nozzles.","Roughness, aging factor, and head-loss allowance are engineering inputs that can materially change the system curve and NPSHa.","Fitting K values can vary by geometry and vendor; typical values are screening inputs until replaced by project/vendor data.","Valve Object losses and valve-like pipe fitting K values should not be counted twice.","Transitional Reynolds-number results are approximate and should be treated as review/warning conditions.","High point vapor margin is a steady-state single-phase screen; it does not model transient, water hammer, flashing, two-phase flow, or gas entrainment."],"formulaDefenseRows":[{"step":"Short Answer for Advisor","inputSource":"Current Pipe Object Properties and solved hydraulic network.","formula":"Darcy-Weisbach major loss + K-method minor loss","substitution":"The pipe uses solved flow, active Fluid Basis, pipe ID, roughness, length, fittings, and elevation profile.","result":"Pipe hydraulic loss trace is available.","literatureBasis":"Fluid mechanics pipe-flow literature and ANSI/HI NPSH suction-loss context.","advisorDefenseNote":"The pipe model is a steady-state, single-phase, incompressible hydraulic calculation, not a transient/two-phase model."},{"step":"Flow Conversion","inputSource":"Solved network flow through the solid hydraulic pipe path.","formula":"Q = flow / 3600","substitution":"39.68 / 3600 = 0.01102222","result":"0.01102222 m3/s","literatureBasis":"SI flow-unit conversion before velocity and Reynolds number.","advisorDefenseNote":"All subsequent pipe equations use SI base units."},{"step":"Pipe Area","inputSource":"Discharge equivalent length NPS 6 Sch 40: pipe size/custom ID source.","formula":"A = pi x D^2 / 4","substitution":"pi x 0.1541^2 / 4 = 0.0187 m2","result":"0.0187 m2","literatureBasis":"Circular pipe geometry.","advisorDefenseNote":"Diameter must follow project piping class or documented custom internal diameter."},{"step":"Velocity","inputSource":"Converted flow and pipe area.","formula":"V = Q / A","substitution":"0.011022 / 0.018651 = 0.591 m/s","result":"0.591 m/s","literatureBasis":"Continuity equation.","advisorDefenseNote":"Velocity drives dynamic head, Reynolds number, major loss, and minor loss."},{"step":"Reynolds Number","inputSource":"Velocity, pipe ID, and Fluid Basis kinematic viscosity.","formula":"Re = V x D / nu","substitution":"0.591 x 0.1541 / 3.3161e-7 = 2.7463e+5","result":"2.7463e+5","literatureBasis":"Internal-flow regime criterion.","advisorDefenseNote":"Laminar, transitional, or turbulent regime determines how friction factor is defended."},{"step":"Darcy Friction Factor","inputSource":"Reynolds number plus effective relative roughness.","formula":"1/sqrt(f) = -2 log10(eps/(3.7D) + 2.51/(Re sqrt(f)))","substitution":"Re = 2.7463e+5; eps/D = 0.000297; regime = Turbulent; f = 0.017099","result":"0.017099","literatureBasis":"Laminar f=64/Re; turbulent Colebrook/Moody; transitional warning band.","advisorDefenseNote":"The application reports Darcy f, not Fanning f."},{"step":"Major Loss","inputSource":"All pipe segments: friction factor, length, diameter, and velocity head.","formula":"h_major,total = sum[f_i x (L_i / D_i) x V_i^2/(2g)]","substitution":"0.2825 = 0.2825 m","result":"0.2825 m","literatureBasis":"Darcy-Weisbach equation.","advisorDefenseNote":"This total matches Pipe Object Properties > Major Loss; segment-level details remain in All Segment Calculation Trace."},{"step":"Minor Loss","inputSource":"All pipe segments: fitting/valve K, quantity, and Add K entries.","formula":"h_minor,total = sum(K_total,i x V_i^2/(2g))","substitution":"0 = 0 m","result":"0 m","literatureBasis":"K-method for fittings, entrances, exits, reducers, strainers, and valve-like losses.","advisorDefenseNote":"This total matches Pipe Object Properties > Minor Loss; K values are typical/user/vendor data depending on source, and separate Valve Object losses must not be counted again here."},{"step":"Allowance and Total Loss","inputSource":"Major loss, minor loss, and optional head-loss allowance.","formula":"h_total = h_major + h_minor + h_allow","substitution":"0.2825 + 0 + 0 = 0.2825 m","result":"0.2825 m","literatureBasis":"Total line loss used by hydraulic energy balance.","advisorDefenseNote":"Suction-side total loss subtracts from NPSHa; discharge-side total loss increases required pump head/system curve."},{"step":"Endpoint Pressure Elevation Rule","inputSource":"Pipe endpoint elevations, solved hydraulic heads, and velocity heads.","formula":"P_in = rho g(H_in - z_start - V_in^2/2g)/100000; P_out = rho g(H_out - z_end - V_out^2/2g)/100000","substitution":"z_start=0 m, z_end=8 m, P_in=5.72 bar a, P_out=4.936 bar a","result":"Outlet pressure follows z_end and solved H_out: 4.936 bar a","literatureBasis":"Bernoulli equation: static pressure is hydraulic head minus elevation head and velocity head.","advisorDefenseNote":"Changing Start Elevation Override affects inlet/profile pressure. Outlet Pressure changes when End Elevation Override, outlet hydraulic head, flow/velocity, or boundary conditions change."}]}}},"SNK-100":{"type":"sink","name":"Reactor Jacket / User D-2201","props":{"active":"Active","boundaryMode":"Flow Demand Boundary","pressureInputBasis":"Absolute","pressure":4.935921887598043,"pressureBasis":"Static","elevation":8,"demandFlow":39.68},"results":{"attachedPipe":"PIPE-2","boundaryPressure":4.936,"boundaryPressureInput":4.936,"pressureInputBasis":"Absolute","calculatedPressure":4.936,"staticPressure":4.936,"stagnationPressure":4.938,"requiredBoundaryPressure":4.936,"pipeEndpointPressure":4.936,"requiredBoundaryHead":60.154,"pressureResidual":null,"flow":39.68,"massFlow":38291.2,"temperature":90,"hydraulicHead":60.158,"pressureBasis":"Static","boundaryMode":"Flow Demand Boundary","status":"OK","warnings":[],"calculationTrace":{"status":"OK","inputBasis":{"sinkId":"SNK-100","boundaryRole":"Fluid Out Boundary","boundaryMode":"Flow Demand Boundary","active":"Active","pressureInputBasis":"Absolute","pressureBasis":"Static","unitStandard":"Internal metric engineering units","hydraulicPipes":["P-100 -> PIPE-2"],"pumpPathStatus":"Valid from P-100","pumpPath":"P-100 - PIPE-2 -> SNK-100","pumpImpactRole":"Discharge fluid-out boundary for pump operating point and NPSH check"},"dependencyChain":["SNK Active state -> determines whether the downstream boundary participates in hydraulic solving.","Boundary Mode -> selects atmospheric pressure, specified outlet pressure, or imposed discharge flow.","Pressure Basis -> gauge/absolute conversion to absolute pressure; free outlet fixes 0 bar g / 1.01325 bar a.","Outlet elevation + pressure head + optional velocity head -> downstream boundary head.","Pipe/fitting/valve/equipment configuration upstream of SNK -> discharge loss seen by the pump.","For pressure/free outlet modes, pump flow is obtained from the pump curve and system curve intersection.","For flow demand mode, pump flow is imposed and required discharge pressure/head is reported as the consequence.","Changed pump flow changes suction losses and NPSHR; changed suction losses directly affect NPSHA.","Fluid Basis density and vapor pressure remain the thermodynamic basis for NPSHA and cavitation margin."],"boundary":{"pressureInput":4.935921887598043,"pressureInputUnit":"bar a","absolutePressureBar":4.935922,"elevation":8,"pressureHead":52.14,"velocityHead":0.018,"hydraulicHead":null,"demandFlow":39.68,"requiredBoundaryPressure":4.935543,"pipeEndpointStaticPressure":4.936,"pipeEndpointStagnationPressure":4.938,"requiredBoundaryHead":60.154},"pumpImpact":{"pumpId":"P-100","flow":39.68,"head":37.67,"npsha":15.36,"npshr":1,"npshMargin":14.36,"npshRatio":15.36,"cavitationStatus":"Safe","explanation":"Flow demand fixes the operating flow. The application then evaluates whether the pump curve can provide the head and NPSH margin at that flow."},"readouts":[{"label":"Boundary Mode","value":"Flow Demand Boundary","unit":"","key":"sink-trace-boundary-mode","kind":"text"},{"label":"Boundary Pressure Input","value":4.935921887598043,"unit":"bar a","key":"sink-trace-pressure-input"},{"label":"Boundary Abs. Pressure","value":4.935921887598043,"unit":"bar a","key":"sink-boundary-pressure"},{"label":"SNK Elevation","value":8,"unit":"m","key":"sink-trace-elevation"},{"label":"Pressure Head","value":52.14011173538731,"unit":"m","key":"sink-trace-pressure-head"},{"label":"Terminal Velocity Head","value":0.017801188735387687,"unit":"m","key":"sink-trace-velocity-head"},{"label":"SNK Hydraulic Head","value":null,"unit":"m","key":"sink-hydraulic-head"},{"label":"Flow Rate","value":39.68,"unit":"m3/h","key":"sink-flow"},{"label":"Mass Flow","value":38291.2,"unit":"kg/h","key":"sink-mass-flow"},{"label":"Pipe Endpoint Static P","value":4.936,"unit":"bar a","key":"sink-static-pressure"},{"label":"Pipe Endpoint Stagnation P","value":4.938,"unit":"bar a","key":"sink-stagnation-pressure"},{"label":"Required Boundary P","value":4.935543221598043,"unit":"bar a","key":"sink-calculated-pressure"},{"label":"Pressure Residual","value":null,"unit":"bar","key":"sink-pressure-residual"},{"label":"Temperature","value":90,"unit":"deg C","key":"sink-temperature"},{"label":"Density Used","value":965,"unit":"kg/m3","key":"sink-fluid-density"},{"label":"Vapor Pressure","value":0.7013169,"unit":"bar a","key":"sink-fluid-vapor-pressure"},{"label":"Pump NPSHA","value":15.36,"unit":"m","key":"sink-pump-npsha"},{"label":"Pump NPSHR","value":1,"unit":"m","key":"sink-pump-npshr"},{"label":"NPSH Margin","value":14.36,"unit":"m","key":"sink-pump-npsh-margin"},{"label":"NPSH Ratio","value":15.36,"unit":"","key":"sink-pump-npsh-ratio"}],"steps":[{"title":"SNK boundary role","formula":"SNK = downstream Fluid Out Boundary","substitution":"SNK-100 uses Flow Demand Boundary","result":"Flow Demand Boundary","unit":"","reference":"Boundary condition definition for pump discharge network solution"},{"title":"Outlet pressure basis","formula":"Pout,abs = Pinput + Patm when gauge; Pout,abs = Pinput when absolute","substitution":"4.936 bar a, basis = Absolute","result":4.935922,"unit":"bar a","reference":"NIST standard atmosphere and pressure head convention"},{"title":"Outlet pressure head","formula":"Hp = Pabs x 100000 / (rho x g)","substitution":"4.935922 bar a, rho = 965.000 kg/m3","result":52.14,"unit":"m","reference":"Bernoulli pressure-head term"},{"title":"Outlet elevation head","formula":"zSNK = user specified outlet elevation","substitution":"SNK-100 elevation = 8.000 m","result":8,"unit":"m","reference":"Hydraulic datum/elevation term"},{"title":"Terminal velocity head","formula":"Hvel = v^2 / (2g)","substitution":"PIPE-2 outlet velocity head = 0.018 m","result":0.018,"unit":"m","reference":"Bernoulli static-to-total pressure relation"},{"title":"Flow demand specification","formula":"Qpump = Qdemand; required boundary pressure is solved from pump head and discharge losses","substitution":"Qdemand = 39.680 m3/h","result":39.68,"unit":"m3/h","reference":"Pump/system operating point and downstream boundary energy balance"},{"title":"Required boundary pressure","formula":"Preq,static = rho x g x (Hrequired_boundary - zSNK - Hvel) / 100000","substitution":"60.154 - 8.000 - 0.018 = 4.935543 bar a","result":4.935543,"unit":"bar a","reference":"Flow-demand boundary consequence from pump head and discharge losses"},{"title":"Pump and NPSH influence","formula":"SNK changes discharge system head or imposed flow, which moves the pump operating point","substitution":"P-100: Q = 39.680 m3/h, H = 37.670 m, NPSHA = 15.360 m, NPSHR = 1.000 m","result":"Safe","unit":"","reference":"Hydraulic Institute NPSH margin guidance and pump curve operating point method"}],"warnings":[],"assumptions":["SNK is a boundary condition for fluid leaving the modeled network; it is not itself a pressure-loss element.","Discharge restriction is calculated from modeled pipes, fittings, valves, vessels, and heat exchangers, not from the SNK label alone.","Free outlet represents atmospheric discharge at the outlet plane with 0 bar gauge pressure.","NPSHA is evaluated on the suction side, but SNK can still change NPSHA indirectly by moving the pump operating flow and suction-side losses."],"references":["pdf_ref/ref4-standar_ANSI-9-6-2024_rotodynamic_pump_guidline_for_NPSH_margin-hydraulic-institute.pdf: NPSHA, NPSHR, NPSH margin, and pump operating margin guidance.","pdf_ref/ref1-fluid-mechanics-fundaments-and-applications.pdf: Bernoulli equation, pressure head, elevation head, velocity head, and head-loss fundamentals.","pdf_ref/ref2-introduction-fluid-mechanics.pdf: steady incompressible flow energy equation and pressure boundary interpretation.","pdf_ref/ref3-cavitations_and_centrifugal_pump_book_edward.pdf: centrifugal pump cavitation and suction-condition interpretation.","NIST Guide to the SI Appendix B: 1 standard atmosphere = 101325 Pa exactly; NASA Glenn Bernoulli page: static plus dynamic pressure forms stagnation pressure."]}},"desc":"Equivalent downstream boundary for the reactor jacket/user. The original discharge manometer reading is preserved in validationAudit."}},"connections":[{"from":"SRC-100","fromPort":".port.outlet","to":"P-100","toPort":".port.inlet","pipeId":"PIPE-1","connectionType":"hydraulic","rawFrom":"SRC-100","rawFromPort":".port.outlet","rawTo":"P-100","rawToPort":".port.inlet","hydraulicReversed":false},{"from":"P-100","fromPort":".port.outlet","to":"SNK-100","toPort":".port.inlet","pipeId":"PIPE-2","connectionType":"hydraulic","rawFrom":"P-100","rawFromPort":".port.outlet","rawTo":"SNK-100","rawToPort":".port.inlet","hydraulicReversed":false}],"instrumentLinks":[],"sourceLinks":[],"visuals":{"SRC-100":{"left":"170px","top":"300px"},"P-100":{"left":"480px","top":"320px"},"SNK-100":{"left":"815px","top":"295px"}}}
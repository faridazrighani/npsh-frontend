":20,"aorMaxPercent":130,"operatingRangeSource":"Project/vendor operating range","operatingPercentBep":22.044,"operatingRegion":"AOR"},"dependencyChain":["Fluid properties -> density, viscosity, vapor pressure","Suction boundary -> absolute pressure head and static elevation","Suction path -> pipe, fitting, valve, equipment loss","Pump datasheet -> BEP, POR/AOR, NPSHr source","System curve -> static boundary head plus suction/discharge losses as a function of flow","Head residual -> pump head minus required system head at evaluated flow","NPSHa calculation -> suction energy above vapor pressure","NPSH standard basis -> required NPSHa by ratio and absolute margin","Final status split -> hydraulic NPSH status, NPSHr data confidence, engineering validation status"],"path":{"sequence":["SRC-100","PIPE-1","P-100"],"text":"SRC-100 -> PIPE-1 -> P-100","dominantLoss":"Suction NPS 8 Sch 40 (0.01 m)"},"losses":{"major":0.01,"minor":0.004,"total":0.014,"entries":[{"id":"PIPE-1","label":"Suction NPS 8 Sch 40","type":"pipe","headLoss":0.014000440002090116,"majorLoss":0.009850440002090115,"minorLoss":0.00415,"details":[{"index":0,"name":"Suction equivalent length NPS 8 Sch 40","notes":"Journal suction equivalent length: NPS 8 Sch 40, total Lt = 19.56 m including pipe, tee, gate valve, eccentric reducer, and inlet.","pipeSize":"Custom diameter","material":"Custom roughness","length":19.56,"diameter":0.2027,"roughness":0.00004572,"effectiveRoughness":0.00004572,"roughnessAgingFactor":1,"fittingType":"None","fittingQuantity":0,"fittingK":0,"fittingTotalK":0,"additionalK":0,"minorLossK":0,"velocity":0.34156375862686533,"reynolds":208786.7180877728,"flowRegime":"Turbulent","regimeWarning":"","frictionFactor":0.017167061519499923,"majorLoss":0.009850440002090115,"fittingLoss":0,"additionalLoss":0,"minorLoss":0,"baseTotalLoss":0.009850440002090115,"allowanceFraction":0,"allowanceLoss":0,"totalLoss":0.009850440002090115,"sizeSource":{"status":"User","source":"User-entered internal diameter"},"materialSource":{"status":"User","source":"User-entered roughness"},"fittingSource":{"status":"Exact","source":"No local fitting loss"}},{"index":1,"name":"Suction strainer journal loss","notes":"Equivalent K selected from the journal strainer loss hstr = 0.00415 m at Q = 39.68 m3/h.","pipeSize":"Custom diameter","material":"Custom roughness","length":0,"diameter":0.2027,"roughness":0.00004572,"effectiveRoughness":0.00004572,"roughnessAgingFactor":1,"fittingType":"Custom K","fittingQuantity":1,"fittingK":0.6979166058724771,"fittingTotalK":0.6979166058724771,"additionalK":0,"minorLossK":0.6979166058724771,"velocity":0.34156375862686533,"reynolds":208786.7180877728,"flowRegime":"Turbulent","regimeWarning":"","frictionFactor":0.017167061519499923,"majorLoss":0,"fittingLoss":0.00415,"additionalLoss":0,"minorLoss":0.00415,"baseTotalLoss":0.00415,"allowanceFraction":0,"allowanceLoss":0,"totalLoss":0.00415,"sizeSource":{"status":"User","source":"User-entered internal diameter"},"materialSource":{"status":"User","source":"User-entered roughness"},"fittingSource":{"status":"User","source":"User-entered loss coefficient"}}],"role":"pipe"}]},"steps":[{"title":"System Static Head","reference":"System curve boundary head difference","formula":"H_static = H_discharge boundary - H_suction boundary","substitution":"60.158 - 22.780 = 37.377 m","result":37.377,"unit":"m"},{"title":"System Curve Head","reference":"Pump curve versus system curve","formula":"H_system(Q) = H_static + hL_suction(Q) + hL_discharge(Q)","substitution":"37.377 + 0.014 + 0.283 = 37.674 m","result":37.674,"unit":"m"},{"title":"Head Residual","reference":"Pump capability at evaluated flow","formula":"Head residual = H_pump(Q) - H_system(Q)","substitution":"37.674 - 37.674 = 0.000 m","result":0,"unit":"m"},{"title":"Source Absolute Pressure","reference":"Pressure basis conversion","formula":"Pabs = Pabs input","substitution":"2.024 = 2.024 bar a","result":2.024,"unit":"bar a"},{"title":"Pressure Head","reference":"Pressure head term in Bernoulli energy balance","formula":"Hp = Pabs x 100000 / (rho x g)","substitution":"2.024 x 100000 / (965.000 x 9.810) = 21.380 m","result":21.38,"unit":"m"},{"title":"Elevation Head","reference":"Static elevation term","formula":"Hz = z_source - z_pump","substitution":"1.400 - 0.000 = 1.400 m","result":1.4,"unit":"m"},{"title":"Source Velocity Head","reference":"Reservoir surface velocity is neglected, or total/stagnation pressure already includes velocity head","formula":"Hvel = 0","substitution":"0.000 m","result":0,"unit":"m"},{"title":"Suction Loss","reference":"Darcy-Weisbach major loss plus minor loss coefficient K","formula":"HL = pipe major + fitting/valve minor","substitution":"0.010 + 0.004 = 0.014 m","result":0.014,"unit":"m"},{"title":"Vapor Pressure Head","reference":"Fluid vapor pressure term in NPSH available","formula":"Hv = Pv x 100000 / (rho x g)","substitution":"0.701317 x 100000 / (965.000 x 9.810) = 7.408 m","result":7.408,"unit":"m"},{"title":"NPSHa","reference":"NPSH available definition from suction energy balance","formula":"NPSHa = Hp + z_source + Hvel - z_pump - HL - Hv","substitution":"21.380 + 1.400 + 0.000 - 0.000 - 0.014 - 7.408 = 15.358 m","result":15.358,"unit":"m"},{"title":"NPSHr","reference":"Engineering-fit curve","formula":"NPSHr = pump required NPSH at operating flow","substitution":"39.680 m3/h -> 1.000 m","result":1,"unit":"m"},{"title":"Operating Region","reference":"Project/vendor operating range; POR/AOR as percent of BEP flow","formula":"Flow %BEP = Q / Q_BEP x 100","substitution":"39.680 / 180.000 x 100 = 22.044 % BEP","result":22.044,"unit":"% BEP"},{"title":"Required NPSHa","reference":"User-defined NPSH margin basis","formula":"Required NPSHa = max(NPSHr x margin ratio, NPSHr + absolute margin)","substitution":"max(1.000 x 1.000, 1.000 + 0.000) = 1.000 m","result":1,"unit":"m"},{"title":"Margin and Ratio","reference":"NPSH margin and ratio diagnostics","formula":"Margin = NPSHa - NPSHr; Ratio = NPSHa / NPSHr; Excess = NPSHa - Required NPSHa","substitution":"15.358 - 1.000 = 14.358 m; 15.358 / 1.000 = 15.358; 15.358 - 1.000 = 14.358 m","result":14.358,"unit":"m"}],"interpretation":{"status":"Warning","hydraulicStatus":"Safe","dataConfidence":"Journal gives one calculated operating point plus design/curve comparison data; full digitized manufacturer curve is not supplied.","dataConfidenceStatus":"Warning","engineeringStatus":"Warning","margin":14.358,"ratio":15.358,"requiredNpsha":1,"npshExcess":14.358,"marginBasis":"User Defined","marginRegionBasis":"user","marginRatioLimit":1,"absoluteMarginLimit":0,"hydraulicMessage":"NPSH margin satisfies the selected engineering basis.","engineeringMessage":"Hydraulic NPSH margin is acceptable, but Engineering Fit is suitable for screening and thesis calculation trace, but final Engineering Validation needs manufacturer/test curve confirmation.","message":"Hydraulic NPSH margin is acceptable, but Engineering Fit is suitable for screening and thesis calculation trace, but final Engineering Validation needs manufacturer/test curve confirmation."},"references":["Bernoulli energy balance","Darcy-Weisbach pipe friction","Minor loss coefficient K for fittings and valves","ANSI/HI 9.6.1-2024 NPSH margin guidance","NPSH available versus required NPSH"],"limitations":["Engineering Fit is suitable for screening and thesis calculation trace, but final Engineering Validation needs manufacturer/test curve confirmation.","Hydraulic trace follows one supported series suction path per pump; branched networks require a nodal solver."],"formulaDefenseSchemaVersion":"pump-formula-defense.v1","academicFormulaDefenseRows":[{"order":1,"step":"System Static Head","inputSource":"Resolved suction and discharge boundary heads plus suction/discharge path losses.","formula":"H_static = H_discharge boundary - H_suction boundary","substitution":"60.158 - 22.780 = 37.377 m","result":37.377,"unit":"m","literature":"Fluid Mechanics: Bernoulli/mechanical energy balance and pump/system curve matching.","defenseNote":"Use the formula, substitution, result, and literature basis as the advisor-facing explanation for this number."},{"order":2,"step":"System Curve Head","inputSource":"Resolved suction and discharge boundary heads plus suction/discharge path losses.","formula":"H_system(Q) = H_static + hL_suction(Q) + hL_discharge(Q)","substitution":"37.377 + 0.014 + 0.283 = 37.674 m","result":37.674,"unit":"m","literature":"Fluid Mechanics: Bernoulli/mechanical energy balance and pump/system curve matching.","defenseNote":"Use this to explain why the pump must provide boundary elevation/pressure difference plus suction and discharge losses."},{"order":3,"step":"Head Residual","inputSource":"Pump head curve at evaluated flow and calculated system head at the same flow.","formula":"Head residual = H_pump(Q) - H_system(Q)","substitution":"37.674 - 37.674 = 0.000 m","result":0,"unit":"m","literature":"Fluid Mechanics: Bernoulli/mechanical energy balance and pump/system curve matching.","defenseNote":"Positive residual means pump head is above system demand at that flow; negative residual means the selected curve cannot satisfy the demanded point."},{"order":4,"step":"Source Absolute Pressure","inputSource":"SRC/tank/vessel boundary pressure basis; gauge pressure is converted to absolute pressure.","formula":"Pabs = Pabs input","substitution":"2.024 = 2.024 bar a","result":2.024,"unit":"bar a","literature":"Local thesis literature set: fluid mechanics, cavitation, and ANSI/HI NPSH margin references.","defenseNote":"NPSH uses absolute pressure. Gauge pressure must be converted before pressure-head calculation."},{"order":5,"step":"Pressure Head","inputSource":"Absolute source pressure, active fluid density, and gravitational acceleration.","formula":"Hp = Pabs x 100000 / (rho x g)","substitution":"2.024 x 100000 / (965.000 x 9.810) = 21.380 m","result":21.38,"unit":"m","literature":"Fluid Mechanics: Bernoulli/mechanical energy balance and pump/system curve matching.","defenseNote":"Use the formula, substitution, result, and literature basis as the advisor-facing explanation for this number."},{"order":6,"step":"Elevation Head","inputSource":"Source liquid/boundary elevation and pump suction datum/nozzle elevation.","formula":"Hz = z_source - z_pump","substitution":"1.400 - 0.000 = 1.400 m","result":1.4,"unit":"m","literature":"Fluid Mechanics: Bernoulli/mechanical energy balance and pump/system curve matching.","defenseNote":"Use the formula, substitution, result, and literature basis as the advisor-facing explanation for this number."},{"order":7,"step":"Source Velocity Head","inputSource":"External header static-pressure basis or inlet pipe velocity head; reservoir velocity is normally neglected.","formula":"Hvel = 0","substitution":"0.000 m","result":0,"unit":"m","literature":"Fluid Mechanics: Bernoulli/mechanical energy balance and pump/system curve matching.","defenseNote":"Use the formula, substitution, result, and literature basis as the advisor-facing explanation for this number."},{"order":8,"step":"Suction Loss","inputSource":"Suction-side pipe segments, fittings, valves, roughness, diameter, length, and flow.","formula":"HL = pipe major + fitting/valve minor","substitution":"0.010 + 0.004 = 0.014 m","result":0.014,"unit":"m","literature":"Fluid Mechanics: Darcy-Weisbach major loss plus minor-loss coefficient K; ANSI/HI Appendix A suction head loss hf.","defenseNote":"This is often the easiest engineering lever to improve NPSHa: reduce length, fittings, K value, velocity, or roughness."},{"order":9,"step":"Vapor Pressure Head","inputSource":"Absolute source pressure, active fluid density, and gravitational acceleration.","formula":"Hv = Pv x 100000 / (rho x g)","substitution":"0.701317 x 100000 / (965.000 x 9.810) = 7.408 m","result":7.408,"unit":"m","literature":"Fluid Mechanics: Bernoulli/mechanical energy balance and pump/system curve matching.","defenseNote":"Use 
n."},"results":{}},"SRC-100":{"type":"source","name":"TK-2941 Hot Water Tank","props":{"sourceType":"Standalone Boundary Source","boundaryDataSource":"Manual","pressureInputBasis":"Absolute","pressure":2.02400901,"pressureEnergyBasis":"Static Pressure","elevation":1.4,"temperatureMode":"Use Fluid Basis","temp":90,"flowInputMode":"Volumetric Flow","flow":39.68,"massFlow":38291.2,"attachedTo":""},"results":{"flow":39.68,"pressure":2.024009,"warnings":[],"calculationTrace":{"status":"OK","inputBasis":{"sourceId":"SRC-100","sourceType":"Standalone Boundary Source","role":"Hydraulic boundary / tie-in","connectionStyle":"Solid hydraulic connection required","boundaryDataSource":"Manual","attachedEquipment":"-","pressureInputBasis":"Absolute","pressureEnergyBasis":"Static Pressure","temperatureMode":"Use Fluid Basis","flowInputMode":"Volumetric Flow","unitStandard":"Internal metric engineering units","hydraulicPipes":["PIPE-1 -> P-100"],"pumpPathStatus":"Valid to P-100","pumpPath":"SRC-100 - PIPE-1 -> P-100"},"dependencyChain":["Source type defines whether the object acts as a hydraulic boundary or an inherited tank/vessel boundary.","Boundary data source defines whether pressure and elevation are entered manually or inherited from connected equipment.","Pressure Basis converts the entered pressure to absolute pressure for hydraulic-head calculation.","Absolute pressure and fluid density are used to calculate pressure head.","Pressure head, source elevation, and applicable velocity head form the source hydraulic head before suction losses.","Temperature mode links the source to the selected fluid basis for density, viscosity, and vapor pressure.","Flow and density are used to calculate mass flow.","Only solid hydraulic connections create a valid hydraulic path from source to pump suction.","Source hydraulic head and vapor pressure are passed to the pump NPSHₐ calculation; suction losses are calculated in the connected suction path."],"boundary":{"pressureInput":2.02400901,"pressureInputUnit":"bar a","absolutePressureBar":2.024009,"elevation":1.4,"pressureHead":21.38,"velocityHead":0,"totalSourceHead":22.78},"readouts":[{"label":"Boundary Pressure Input","value":2.02400901,"unit":"bar a","key":"source-trace-pressure-input"},{"label":"Calculated Abs. Pressure","value":2.02400901,"unit":"bar a","key":"source-absolute-pressure"},{"label":"Source Elevation","value":1.4,"unit":"m","key":"source-effective-elevation"},{"label":"Pressure Head","value":21.38041450777202,"unit":"m","key":"source-trace-pressure-head"},{"label":"Velocity Head","value":0,"unit":"m","key":"source-trace-velocity-head"},{"label":"Source Hydraulic Head","value":22.78041450777202,"unit":"m","key":"source-trace-hydraulic-head"},{"label":"Mass Flow","value":38291.2,"unit":"kg/h","key":"source-mass-flow"},{"label":"Volumetric Flow","value":39.68,"unit":"m3/h","key":"source-flow"},{"label":"Temperature","value":90,"unit":"deg C","key":"source-temperature"},{"label":"Density Used","value":965,"unit":"kg/m3","key":"source-fluid-density"},{"label":"Kinematic Viscosity","value":0.3316062176165804,"unit":"cSt","key":"source-fluid-viscosity"},{"label":"Dynamic Viscosity","value":0.32000000000000006,"unit":"cP","key":"source-fluid-dynamic-viscosity"},{"label":"Specific Weight","value":9466.65,"unit":"N/m3","key":"source-fluid-specific-weight"},{"label":"Vapor Pressure","value":0.7013169,"unit":"bar a","key":"source-fluid-vapor-pressure"},{"label":"Vapor Pressure Head","value":7.408290155440415,"unit":"m","key":"source-fluid-vapor-pressure-head"}],"steps":[{"title":"Source role","formula":"SRC role = sourceType rule","substitution":"Standalone Boundary Source -> Solid hydraulic connection required","result":"Hydraulic boundary / tie-in","unit":"","reference":"SRC boundary model: semantic attachment edges are excluded from hydraulic graph traversal"},{"title":"Absolute pressure","formula":"Pabs = Pabsolute input","substitution":"2.024 bar a","result":2.024009,"unit":"bar a","reference":"Pressure basis conversion"},{"title":"Source elevation","formula":"z_source = manual SRC elevation","substitution":"1.400 m","result":1.4,"unit":"m","reference":"Manual SRC boundary elevation"},{"title":"Pressure head","formula":"Hp = Pabs x 100000 / (rho x g)","substitution":"2.024009 x 100000 / (965.000 x 9.810) = 21.380 m","result":21.38,"unit":"m","reference":"Pressure-to-head conversion"},{"title":"Mass flow conversion","formula":"massFlow = Q x density","substitution":"39.680 x 965.000 = 38291.200 kg/h","result":38291.2,"unit":"kg/h","reference":"Volumetric-flow to mass-flow conversion using effective SRC density"},{"title":"Source hydraulic head","formula":"Hsource = Hp + z_source","substitution":"21.380 + 1.400 + 0.000 = 22.780 m","result":22.78,"unit":"m","reference":"Hydraulic energy head used by source boundary calculations"},{"title":"Hydraulic traversal","formula":"Hydraulic graph uses solid pipe/component edges","substitution":"PIPE-1 -> P-100","result":"Valid to P-100","unit":"","reference":"Hydraulic graph traversal rule"}],"warnings":[],"assumptions":["SRC represents a hydraulic boundary condition, not a pipe, fitting, valve, or pressure-loss element.","Only solid hydraulic pipe connections are used for hydraulic traversal and pressure-loss calculation.","For open tank or reservoir boundaries, source velocity head is neglected. For external header/tie-in boundaries, velocity head is considered only when static pressure and flow-area data are available."],"references":["pdf_ref/ref4-standar_ANSI-9-6-2024_rotodynamic_pump_guidline_for_NPSH_margin-hydraulic-institute.pdf: NPSHA terms, vapor pressure head, suction velocity head, suction loss, and datum concept.","pdf_ref/ref1-fluid-mechanics-fundaments-and-applications.pdf: pressure head, Bernoulli/energy balance, specific weight, and head-loss fundamentals.","pdf_ref/ref2-introduction-fluid-mechanics.pdf: Bernoulli equation and incompressible steady-flow energy balance.","pdf_ref/ref3-cavitations
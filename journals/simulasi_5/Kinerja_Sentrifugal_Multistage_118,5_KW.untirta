000000d5{"fileFormat":"untirta-npsh-simulation","fileVersion":1,"compression":"none","checksum":"288948a2acbb4837c44500ca50c0673783d8a127ccfd51cf6647d1407619d29d","payloadBytes":66992,"savedAt":"2026-05-22T12:42:44.135Z"}{"projectFile":{"fileFormat":"untirta-npsh-simulation","fileVersion":1,"preferredExtension":".untirta","sourceFormat":"journal-iso9906-multistage-pump-validated-app-closure","title":"Pengujian Kinerja Pompa Sentrifugal Multistage 118,5 kW pada PLTP Berdasarkan ISO 9906","validatedAgainst":"Kinerja_Sentrifugal_Multistage_118,5_KW.pdf","validationStatus":"journal-iso9906-audited-active-point-developed","validationAudit":{"reviewedAt":"2026-05-22T12:42:44.134Z","journalFile":"journals/simulasi_5/Kinerja_Sentrifugal_Multistage_118,5_KW.pdf","modelFile":"journals/simulasi_5/Kinerja_Sentrifugal_Multistage_118,5_KW.untirta","validationBasis":"Primary references are Table 1 pump specification, Table 2 piping/environment data, Table 4 test readings, Table 5 calculated head components, Table 6 test compilation, and the conclusion.","journalTargets":{"manufacturer":"OSNA Pumpen Technologie","model":"NMH 32-80","type":"Horizontal Multi Stage Bare shaft end","stages":4,"ratedFlowM3H":108,"ratedHeadM":300,"npshrM":3.3,"powerInputAtPumpShaftKw":118.5,"motorCapacityRequiredKw":132,"efficiencyPercent":69,"guarantee":"ISO 9906, Class 2","pipeInsideDiameterM":0.202715,"roughnessM":0.00015,"fluid":"Water","temperatureC":20,"densityKgM3":998.2,"dynamicViscosityKgMS":0.001002,"specificWeightKNM3":9.789,"ambientPressureBarA":0.827,"reservoirElevationAbovePumpM":11,"activeValveOpeningPercent":100,"activeFlowM3H":116.64,"activeHeadM":275.13,"activeHeadPressureTermM":271.64,"activeVelocityHeadTermM":-0.16,"activeSuctionPressureBar":0.9,"activeDischargePressureBar":27.5,"activeSuctionMajorLossM":0.54,"activeSuctionMinorLossM":0.9,"activeDischargeMajorLossM":1.55,"activeDischargeMinorLossM":0.49,"hqTestPoints":[{"valveOpeningPercent":20,"suctionPressureBar":1.1,"dischargePressureBar":31.3,"flowLs":19.5,"flowM3H":70.2,"headM":309.7,"hvM":-0.07,"hpM":308.4,"hfdM":0.59,"hfsM":0.21,"hldM":0.18,"hlsM":0.33},{"valveOpeningPercent":40,"suctionPressureBar":1,"dischargePressureBar":30.9,"flowLs":21.3,"flowM3H":76.68,"headM":306.88,"hvM":-0.07,"hpM":305.34,"hfdM":0.69,"hfsM":0.24,"hldM":0.21,"hlsM":0.39},{"valveOpeningPercent":60,"suctionPressureBar":1,"dischargePressureBar":30.3,"flowLs":24.1,"flowM3H":86.76,"headM":301.17,"hvM":-0.09,"hpM":299.21,"hfdM":0.88,"hfsM":0.31,"hldM":0.27,"hlsM":0.5},{"valveOpeningPercent":80,"suctionPressureBar":0.9,"dischargePressureBar":29.6,"flowLs":29.2,"flowM3H":105.12,"headM":295.93,"hvM":-0.07,"hpM":293.09,"hfdM":1.27,"hfsM":0.45,"hldM":0.4,"hlsM":0.73},{"valveOpeningPercent":100,"suctionPressureBar":0.9,"dischargePressureBar":27.5,"flowLs":32.4,"flowM3H":116.64,"headM":275.13,"hvM":-0.16,"hpM":271.64,"hfdM":1.55,"hfsM":0.54,"hldM":0.49,"hlsM":0.9}]},"applicationClosure":{"sourcePressureBarA":0.827,"sinkReferencePressureBarA":27.42460077,"appRequiredHeadM":275.13,"appPumpHeadM":275.13,"appHeadResidualM":0,"appSuctionLossM":1.446544,"appDischargeLossM":2.015752,"appDerivedNpshaM":17.75997,"appNpshrM":3.3,"appNpshMarginM":14.45997,"appHydraulicPowerKw":87.291013,"appShaftPowerAt69PercentKw":126.508714,"appOutletHydraulicHeadM":291.113078,"appOutletVaporMarginM":279.822853,"appSuctionMajorLossM":0.5450878,"appSuctionMinorLossM":0.90145662,"appDischargeMajorLossM":1.55089857,"appDischargeMinorLossM":0.4648537},"journalInconsistencies":["Table 2 labels the 307 m and 107.9 m pipe branches under headings that conflict with the hfd/hfs/hld/hls loss columns. The model maps 107.9 m + high-K fittings to suction loss and 307 m + lower-K fittings to discharge loss because that reproduces the Table 5 loss grouping.","The paper gives the NPSHA formula and environment data but does not publish a final NPSHA value; this file stores a derived NPSHA from those inputs.","Power input 118.5 kW and efficiency 69% are from the specification table and do not exactly close with every field-test H-Q point; app power uses the active H-Q point with the published efficiency.","The paper calls the 2019 maximum-flow result 116 m3/h in the conclusion and 116.64 m3/h in the tables/abstract; the model uses the table value 116.64 m3/h.","Tabel 5 component values are rounded and do not exactly sum to the reported Htot column; the model uses the published Htot values because they are repeated in Tabel 6 and the abstract as the official H-Q curve."],"appOnlyAssumptions":["Downstream SNK pressure is an equivalent closure boundary so the application required-head calculation equals the journal active head 275.13 m at Q = 116.64 m3/h.","Water vapor pressure at 20 deg C is supplied from standard water-property data because the PDF omits the numeric Psat used in NPSHA.","Efficiency and NPSHr are held constant across H-Q curve rows because measured curves are not supplied.","SNK-100 pressure is an equivalent downstream closure boundary, not the Tabel 4 discharge pressure gauge reading; it is derived so the application system-head equation closes at Htot = 275.13 m and Q = 116.64 m3/h."],"engineeringAudit":{"auditStatus":"audited-defensible-with-documented-literature-limitations","auditDate":"2026-05-21T01:19:50.650Z","sourcePdf":"Kinerja_Sentrifugal_Multistage_118,5_KW.pdf","componentBasis":[{"block":"FLUID","source":"Tabel 2 - Cairan Yang Digunakan","values":{"fluid":"Air/Water","temperatureC":20,"densityKgM3":998.2,"dynamicViscosityKgMS":0.001002,"specificWeightKNM3":9.789},"appMapping":"Fluid Basis stores density 998.2 kg/m3, dynViscosity 1.002 mPa.s, kinematic viscosity 1.003806852 cSt, and gamma 9789 N/m3. Vapor pressure is standard water Psat at 20 deg C because the paper does not publish Psat."},{"block":"SRC-100 / Thermal Pond Source","source":"Tabel 2 - Ketinggian dan tekanan udara; Section 2.3 closed-loop test from upper thermal pond","values":{"pondElevationMdpl":1631,"pumpElevationMdpl":1620,"reservoirAbovePumpM":11,"ambientPressureBarA":0.827},"appMapping":"Application datum uses source elevation +11 m because the reservoir surface is 11 m above pump datum. The paper writes -11 m under its sign convention."},{"block":"PIPE-1 / Suction Branch","source":"Tabel 2 pipe data cross-checked against Tabel 5 hfs/hls values","values":{"diameterM":0.202715,"roughnessM":0.00015,"lengthM":107.9,"totalK":17.55,"fittings":"4x 90 deg elbow K0.3, 7x 45 deg long-radius elbow K0.2, 3x gate valve K0.15, tee branch K1, globe valve K10, sharp inlet K0.5, sharp outlet K1, bucket strainer K2"},"appMapping":"Although the table heading is inconsistent, this branch is mapped to suction because it reproduces the published 100% suction losses hfs about 0.54 m and hls about 0.90 m."},{"block":"P-100 / Pump","source":"Tabel 1 specification; Tabel 4 measured flow; Tabel 5 and Tabel 6 H-Q test points","values":{"manufacturer":"OSNA Pumpen Technologie","model":"NMH 32-80","type":"Horizontal Multi Stage Bare shaft end","stages":4,"ratedFlowM3H":108,"ratedHeadM":300,"npshrM":3.3,"shaftPowerKw":118.5,"motorKw":132,"efficiencyPercent":69,"curveFlowHead":[{"openingPercent":20,"flowM3H":70.2,"headM":309.7},{"openingPercent":40,"flowM3H":76.68,"headM":306.88},{"openingPercent":60,"flowM3H":86.76,"headM":301.17},{"openingPercent":80,"flowM3H":105.12,"headM":295.93},{"openingPercent":100,"flowM3H":116.64,"headM":275.13}]},"appMapping":"Advanced curve uses the five published 12-Dec-2019 H-Q points. Efficiency 69% and NPSHr 3.3 m are held constant because the paper gives specification values but not measured efficiency or NPSHr curves."},{"block":"PIPE-2 / Discharge Branch","source":"Tabel 2 pipe data cross-checked against Tabel 5 hfd/hld values","values":{"diameterM":0.202715,"roughnessM":0.00015,"lengthM":307,"totalK":9.05,"fittings":"10x 90 deg smooth bend K0.3, 5x 45 deg elbow K0.2, 2x pipe inlet K0.5, 3x pipe exit K1, 7x gate valve K0.15"},"appMapping":"This branch is mapped to discharge because L=307 m gives the published 100% discharge major loss hfd about 1.55 m."},{"block":"SNK-100 / Equivalent Downstream Boundary","source":"Not a direct journal gauge value; derived closure from Tabel 5 active Htot and app hydraulic balance","values":{"demandFlowM3H":116.64,"equivalentPressureBarA":27.4246007704},"appMapping":"SNK pressure is an equivalent boundary after the discharge-pipe loss so the app required head equals the published active Htot 275.13 m. It must not be cited as the journal discharge pressure gauge; the journal gauge is 27.50 bar in Tabel 4."}],"calculationChecksAt100Percent":{"flowM3S":0.0324,"pipeAreaM2":0.03227466,"velocityMS":1.003884,"reynolds":202730.5,"frictionFactor":0.019937,"velocityHeadM":0.051365,"pressureHeadFromGaugeReadingsM":271.7336,"publishedPressureHeadM":271.64,"suctionMajorLossM":0.5451,"suctionMinorLossM":0.9015,"dischargeMajorLossM":1.5509,"dischargeMinorLossM":0.4649,"publishedHtotM":275.13,"appRequiredHeadM":275.13,"appPumpHeadM":275.13,"appHeadResidualM":0,"derivedNpshaM":17.76,"npshrM":3.3,"npshMarginM":14.46,"hydraulicStatus":"Safe","engineeringStatus":"Warning - measured efficiency and NPSHr curves are not published in the paper"},"literatureLimitationsForDefense":["Tabel 5 reports rounded component heads; summing the rounded values does not exactly reproduce Htot. At 100% opening, rounded components sum to about 274.96 m while the table reports Htot 275.13 m. The model uses Htot because it is repeated in Tabel 6 and in the abstract as the official H-Q curve value.","Tabel 2 has inconsistent suction/discharge labels versus Ld/Ls and versus hfd/hfs/hld/hls. The model maps branches by hydraulic loss reproduction, not by the ambiguous heading text alone.","SNK-100 is a computational equivalent boundary. It is necessary because the paper gives pump/test head and pressure readings, not a complete downstream reservoir boundary condition for the app network solver.","NPSHa is derived from the published environmental data and standard water vapor pressure at 20 deg C; the paper gives the formula but not a final NPSHa number."]},"detailedAnalysisReport":{"reportFile":"journals/analysis-reports/simulasi-5-analysis.json","markdownFile":"journals/simulasi_5/audit_validasi_Kinerja_Sentrifugal_Multistage_118,5_KW.md","comparisonRowCount":63,"largestDeviationMetric":"Pipe Discharge - Minor loss","largestDeviationPercent":5.131898,"status":"Conditionally validated with documented journal caveats and equivalent closures"},"optimizePumpFromNetwork":{"runAt":"2026-05-22T12:42:44.134Z","readinessStatus":"Ready","canRun":true,"proposalStatus":"Proposal Ready","canApply":true,"appliedToPumpInputs":false,"targetFlowM3H":116.64,"requiredSystemHeadM":275.13,"npshaAtDesignM":17.76,"maxAllowableNpshrM":16.778,"proposedNpshrM":15.939,"retainedJournalNpshrM":3.3,"decision":"Optimization proposal is recorded for engineering review; journal/literature duty inputs are retained for validation."}}},"model":{"SETTINGS":{"type":"settings","name":"Simulation Settings","props":{"unitStandard":"Metric / European Engineering","basisConfirmed":true,"basisDirty":false,"lastConfirmedFluid":"Water","lastConfirmedTemperature":20,"lastConfirmedUnitStandard":"Metric / European Engineering","migratedFromLegacy":false,"importSource":"Journal ISO 9906 multistage pump validation model","importCaseName":"Kinerja_Sentrifugal_Multistage_118,5_KW - PLTP ISO 9906 field performance test","dynamicStepSeconds":60,"dynamicRealtimeIntervalMs":60000,"dynamicSimulationTimeSeconds":0,"dynamicInventoryEnabled":false,"lastDynamicStepStatus":"Not started"}},"FLUID":{"type":"fluid","name":"Fluid Basis","props":{"inputMode":"Basic","fluidName":"Water","temp":20,"density":998.2,"sg":0.9982279503826108,"viscosity":1.003806852,"dynViscosity":1.002,"vaporPressure":0.02339,"specificHeat":4.181,"bulkModulus":2.18,"specVolume":0.0010018032458425164,"specWeight":9789,"vaporPressureHead":0.2388601215112789,"speedOfSound":1482,"thermalConductivity":0.598,"dielectr
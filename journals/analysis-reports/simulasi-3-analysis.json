  "formulas": [
    {
      "name": "Fluid specific weight",
      "formula": "gamma = rho x g"
    },
    {
      "name": "Kinematic viscosity",
      "formula": "nu = mu / rho when the journal gives dynamic viscosity only"
    },
    {
      "name": "Vapor pressure head",
      "formula": "Hv = Pv x 100000 / (rho x g)"
    },
    {
      "name": "Reynolds number",
      "formula": "Re = V D / nu"
    },
    {
      "name": "Relative roughness",
      "formula": "eps/D = pipe roughness / internal diameter"
    },
    {
      "name": "Darcy-Weisbach major loss",
      "formula": "h_major = f (L / D) (V^2 / 2g)"
    },
    {
      "name": "Minor loss",
      "formula": "h_minor = K (V^2 / 2g)"
    },
    {
      "name": "System head closure",
      "formula": "H_required = H_discharge boundary - H_suction boundary + hL_suction + hL_discharge"
    },
    {
      "name": "NPSHa",
      "formula": "NPSHa = suction boundary head - suction loss - pump elevation - vapor pressure head"
    },
    {
      "name": "NPSH acceptance",
      "formula": "Hydraulic status is Safe when NPSHa > NPSHr; Cavitation Risk when NPSHa < NPSHr"
    },
    {
      "name": "NPSH margin and ratio",
      "formula": "Margin = NPSHa - NPSHr; Ratio = NPSHa / NPSHr"

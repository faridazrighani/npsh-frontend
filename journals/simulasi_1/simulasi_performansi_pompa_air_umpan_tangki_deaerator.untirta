000000d1{"fileFormat":"untirta-npsh-simulation","fileVersion":1,"compression":"none","checksum":"aa7156ebf2131db65321da0cbc594fbbb7d6ea601d41f211944c67ef3ffb57b7","payloadBytes":40576,"savedAt":"2026-05-23T13:46:04Z"}{"projectFile":{"fileFormat":"untirta-npsh-simulation","fileVersion":1,"preferredExtension":".untirta","sourceFormat":"journal-case6-validated-app-closure","validationAudit":{"reviewedAt":"2026-05-23T13:46:04Z","journalFile":"journals/simulasi_1/analisisi_performansi_pompa_air_umpan_tangki_deaerator.pdf","modelFile":"journals/simulasi_1/simulasi_performansi_pompa_air_umpan_tangki_deaerator.untirta","validationBasis":"Table 2/Table 3 are used for visible Pipe Segment inputs, while the detailed loss calculation is used for calculation-only terms and validation totals; documented journal inconsistencies are retained as audit notes.","journalTargets":{"flowM3H":50,"temperatureC":100,"dutyHeadM":24,"exactCalculatedHeadM":23.8178,"efficiencyPercent":62,"npshaM":6.4656,"npshrM":2.4002,"pumpPowerKwTable8":5.0578,"motorPowerKwTable8":6.0694,"suctionLossJournalM":2.6303,"dischargeLossJournalM":11.6875,"nameplateHeadM":42,"nameplateCapacityM3H":50,"nameplatePowerKw":15,"pumpSpeedRpm":2930,"suctionStaticHeadM":0.5,"dischargeStaticHeadM":10,"totalStaticHeadM":9.5,"suctionDiameterM":0.098,"suctionLengthM":2,"dischargeDiameterM":0.0738,"dischargeLengthM":10,"galvanizedRoughnessM":0.00015,"kinematicViscosityM2S":8.03e-07,"suctionMajorLossM":0.0796,"suctionMinorValveElbowLossM":2.1184,"suctionSuddenContractionLossM":0.415,"suctionTankOutletLossM":0.0173,"dischargeMajorLossM":1.761,"dischargeMinorValveCheckElbowLossM":5.1985,"dischargeSuddenChangeLossM":2.9047,"deaeratorInletLossM":0.2696,"dischargePressureTermLossM":1.5607,"totalHeadLossM":14.3178,"specificSpeedRpm":1081.3562,"pumpPowerKwAbstract":5.0194,"motorPowerKwAbstract":6.0233,"suctionLossUsedInNpshPrintedM":2.7145,"actualFlowM3H":50,"actualHeadM":24,"headM":24,"actualEfficiencyPercent":62,"publishedPumpEfficiencyPercent":62,"suctionHeadLossM":2.6303,"dischargeHeadLossM":11.6875,"densityKgM3":958.2059123343527,"vaporPressureKpa":101.325,"suctionElbowAngleTableDeg":45,"suctionElbowKUsedInCalculation":0.27,"suctionLossPrintedSubtotalTypoM":2.6393,"dischargeElbowCountTable":4,"dischargeElbowCountCalculation":6,"dischargeSuddenChangePrintedLineM":2.9873,"dischargeSuddenChangeUsedInTotalM":2.9047},"applicationClosure":{"sourcePressureBarA":1.820926476,"sinkReferencePressureBarA":1.743707129,"appNpshaM":6.4656,"appRequiredHeadM":24,"appSuctionLossM":2.615534,"appDischargeLossM":11.668509,"appHeadResidualM":0,"appSuctionMajorLossM":0.08038,"appSuctionMinorLossM":2.535154,"appDischargeMajorLossM":1.756237,"appDischargeMinorLossM":9.912272,"appOutletHydraulicHeadM":29.084635,"appOutletVaporMarginM":7.759774},"journalInconsistencies":["Nameplate head is 42 m, while calculated operating head is 23.8178 m rounded to 24 m; the simulation uses the operating head.","Abstract power values 5.0194 kW and 6.0233 kW follow the exact 23.8178 m head, while Section 3.4/Table 8 values 5.0578 kW and 6.0694 kW use rounded 24 m.","Discharge-pipe Table 3 lists four long-radius elbows, while the detailed calculation uses six elbows. The Pipe Segments now show four table elbows plus two calculation-only elbows so both journal locations are traceable.","The NPSHa printed substitution line gives hs = 0.9 m and hf,s = 2.7145 m, but the published result 6.4656 m is reproduced by hs = 0.5 m and hf,s = 2.7145 m.","The NPSH pressure units are printed inconsistently around Pa/Pv; the simulator therefore uses physical water vapor pressure and equivalent source pressure closure.","Some published loss subtotals differ by arithmetic typo/rounding: suction is printed once as 2.6393 m but sums to 2.6303 m, and discharge sudden-change is printed as 2.9873 m while the published total uses 2.9047 m."],"appOnlyAssumptions":["Pump curve end points outside the duty point are engineering-fit placeholders because the journal does not provide a manufacturer pump curve.","SRC-100 pressure is an equivalent boundary, not a direct field measurement, chosen to reproduce the published NPSHa with the application water-property basis.","SNK-100 reference pressure is set to the closure pressure that makes the application system-head calculation equal 24.00 m at 50 m3/h.","Journal provides only the operating/duty point (Q=50 m3/h, H=24 m, eta=62%, NPSHr=2.4002 m); off-duty curve endpoints are application engineering-fit placeholders and are not manufacturer/test data."],"validationConclusion":"Conditionally validated: all available journal inputs that map to application fields are represented; values not available in the journal are explicitly marked as application-equivalent or engineering-fit assumptions.","referencePriority":["Use detailed calculation section and Table 8 for the operating simulation point.","Use nameplate data only as equipment metadata/context where the application has no direct field.","Use published final NPSHa/NPSHr as validation targets because the printed NPSH substitution line has unit/rounding inconsistencies.","Use application water-property basis at 100 deg C where the journal gives only gamma and kinematic viscosity."],"chainAudit":[{"stage":"Fluid Basis","journalBasis":"Feed water/air at Tf = 100 deg C; gamma = 9400 N/m3; kinematic viscosity = 8.03e-7 m2/s; Pv line printed as 10332 Kgf/m2.","modelBasis":"Water at 100 deg C; density 958.3483835924421 kg/m3; specWeight 9398.187175956822 N/m3; viscosity 0.803 cSt; vaporPressure 1.0141799381792784 bar a.","status":"Direct for temperature/viscosity; engineering property basis for density and vapor pressure.","note":"App specWeight 9398 N/m3 matches journal gamma 9400 within rounding. Vapor pressure is kept physically consistent for water at 100 deg C; source pressure is calibrated to preserve published NPSHa."},{"stage":"SRC / Feed Water Tank Boundary","journalBasis":"Hot feed water tank to pump suction; pump below suction side by 0.5 m; no direct source pressure boundary is provided.","modelBasis":"SRC-100 fixed volumetric flow 50 m3/h, elevation 0 m, equivalent pressure 1.820926476424815 bar a.","status":"Flow and elevation are journal-supported; pressure is application-equivalent.","note":"Equivalent pressure is required because the application solves absolute hydraulic energy, while the journal NPSH expression uses a mixed pressure basis."},{"stage":"Suction Pipe / Fittings","journalBasis":"4 in suction pipe, Di = 0.098 m, L = 2 m, galvanized roughness 0.15 mm, globe K = 5.8 and 6.1, Table 2 elbow angle = 45 deg, detailed calculation applies long-radius elbow K = 0.27, sudden contraction loss 0.4150 m, tank outlet K = 0.1.","modelBasis":"PIPE-1 segments preserve D, L, roughness, direct K values; sudden contraction is represented as equivalent K = 2.400754913132784 at 50 m3/h.","status":"Validated with minor numerical difference from pi/g rounding.","note":"The table gives a 45 deg elbow description while the calculation labels the coefficient line as 90 deg; the model keeps the journal K = 0.27 and documents the angle caveat in the segment note."},{"stage":"Pump","journalBasis":"Nameplate: Q = 50 m3/h, H = 42 m, P = 15 kW, n = 2930 rpm. Operating calculation: Hp = 23.8178 m rounded to 24 m, eta = 62%, NPSHr = 2.4002 m.","modelBasis":"P-100 Basic mode: designFlow 50 m3/h, designHead 24 m, efficiency 62%, manual NPSHr 2.4002 m.","status":"Operating simulation point validated; nameplate speed/head retained in audit, not direct pump fields.","note":"The app has no pump-speed input in this Basic model. Pump curve endpoints are engineering-fit placeholders because no manufacturer curve is published in the journal."},{"stage":"Discharge Pipe / Fittings","journalBasis":"3 in discharge pipe, Di = 0.0738 m, L = 10 m, galvanized roughness 0.15 mm, globe K = 6.1, swing check K = 1.8, Table 3 has four long-radius elbows, calculation adds two more elbows for six total at K = 0.29 each, sudden-change subtotal term 2.9047 m, deaerator inlet K = 0.5, pressure term 1.5607 m.","modelBasis":"PIPE-2 preserves D, L, roughness, valve/check K values, splits elbows into four table elbows plus two calculation-only elbows, and uses equivalent K values for sudden-change and pressure-term losses.","status":"Validated against the calculation section rather than the table count.","note":"The visible Pipe Segments now make the Table 3 vs calculation mismatch explicit while retaining the six-elbow total needed to reproduce the published discharge-loss total."},{"stage":"SNK / Deaerator Boundary","journalBasis":"Deaerator receiving side elevation hd = 10 m; journal includes an additional 1.5 bar pressure term as hf3 = 1.5607 m, but no direct outlet boundary pressure for simulator closure.","modelBasis":"SNK-100 Flow Demand Boundary 50 m3/h, elevation 10 m, equivalent reference pressure 1.7437071290497523 bar a.","status":"Flow and elevation are journal-supported; reference pressure is application-equivalent.","note":"The SNK pressure is set so application required head equals 24.00 m at 50 m3/h while preserving the journal discharge pressure-term loss as an equivalent segment."}],"calculationChecks":{"journalArithmetic":{"suctionLossSumM":2.6303,"dischargeLossSumM":11.6875,"totalLossM":14.3178,"staticHeadM":9.5,"calculatedHeadM":23.8178,"roundedDutyHeadM":24,"powerAtExactHeadKw":5.0194,"powerAtRoundedHeadKw":5.0578,"motorPowerAtRoundedHeadKw":6.0694},"applicationRecalculation":{"sourcePressureBarA":1.820926476,"sinkReferencePressureBarA":1.743707129,"appNpshaM":6.4656,"appRequiredHeadM":24,"appSuctionLossM":2.615534,"appDischargeLossM":11.668509},"npshPrintedLineAudit":{"printedLine":"(1.01325e5 - 10332)/9400 - 0.9 - 2.7145 = 6.4656 m","recomputedIfPrintedLiterallyM":6.0656,"recomputedUsingHs05AndHf27145M":6.4656,"conclusion":"The final NPSHa 6.4656 m is reproducible if hs = 0.5 m is used; the printed 0.9 appears to be a typo or carry-over error."},"acceptance":{"npshaM"